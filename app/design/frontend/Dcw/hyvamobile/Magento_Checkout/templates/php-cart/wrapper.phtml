<script>
    document.addEventListener("DOMContentLoaded", function () { 
        const cartItems = document.querySelectorAll("#shopping-cart-table tbody");
        let uniqueSkuClasses = new Set();
        let normalProductCount = 0;
        cartItems.forEach((tbody) => {
            let skuClass = null;
            // Find if tbody has a class that starts with "sku-"
            tbody.classList.forEach((cls) => {
                if (cls.startsWith("sku-")) {
                    skuClass = cls; // Get the exact CBC product class
                }
            });
            if (skuClass) {
                // Store unique CBC SKU classes (count each only once)
                uniqueSkuClasses.add(skuClass);
            } else {
                // Count normal products separately
                normalProductCount++;
            }
        });
        // Total count = unique SKU products + normal products
        const totalCount = uniqueSkuClasses.size + normalProductCount;
        // Update the count in the cart
        const countElement = document.querySelector(".checkout-cart-index .page-title-shopping-cart span");
        if (countElement) {
            countElement.textContent = `(${totalCount})`;
        }
    });
</script>