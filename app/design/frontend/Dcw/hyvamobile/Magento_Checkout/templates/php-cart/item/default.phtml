                                        required="required"
                                        min="0"
                                        <?= ($product->getIncstoresFreeProduct() == 1)?'readonly disabled':''; ?>
                                        data-role="cart-item-qty"/>
                                </label>
                            </div>
                        </div>
                    </div>
                <?php } ?>

                <?php if ($isCbcProduct) { ?>
                    <div class="col qty block w-full flex flex-wrap">
                        <?php foreach ($cartCbcData as $cbcFullData => $cbcItems) { ?>
                            <?php foreach ($cbcItems as $key => $cbcItem) { ?>
                                <?php if ($cbcProductMatch == $cbcFullData) { ?>       
                                    <div class="cbc_qty w-full">                 
                                        <span class="sr-only">
                                            <?= $escaper->escapeHtml(__('Qty')) ?>
                                        </span>
                                        <div class="field qty flex items-center justify-end">
                                            <p class="custom-price-title"><?= $escaper->escapeHtmlAttr($cbcItem['cbcType']).' Tiles' ?></p>
                                            <div class="control qty">
                                                <label for="cart-<?= $escaper->escapeHtmlAttr($cbcItem['itemId']) ?>-qty">
                                                    <span class="label sr-only"><?= $escaper->escapeHtml(__('Qty')) ?></span>
                                                    <input id="cart-<?= $escaper->escapeHtmlAttr($cbcItem['itemId']) ?>-qty"
                                                        name="cart[<?= $escaper->escapeHtmlAttr($cbcItem['itemId']) ?>][qty]"
                                                        value="<?= $escaper->escapeHtmlAttr($cbcItem['qty']) ?>"
                                                        type="text"
                                                        size="4"
                                                        onkeypress="return onlyNumberKey(event)"
                                                        onblur="submitForm(event)"
                                                        step="any"
                                                        title="<?= $escaper->escapeHtmlAttr(__('Qty')) ?>"
                                                        class="qty form-input px-2 py-2 w-20 text-center"
                                                        required="required"
                                                        min="0"
                                                        <?= ($product->getIncstoresFreeProduct() == 1)?'readonly disabled':''; ?>
                                                        data-role="cart-item-qty"/>
                                                </label>
                                            </div>                                                
                                        </div>       
                                    </div>                     
                                <?php } ?>
                            <?php } ?>
                        <?php } ?>
                    </div>
                <?php } ?>
            </div>
            <div class="cart-right">
                <div class="product-item-details grow">
                    <span class="product-item-name break-all sm:text-size14 font-semibold" style="color:#252525;">
                        <a href="<?= $escaper->escapeUrl($optionurl) ?>"><?= $escaper->escapeHtml($block->getProductName()) ?></a>
                        <p class="variant-display-name"><?php echo $variantDisplayName.$getProductWeightHtml;?></p>
                        <p class="custom-price-section">(<?= $productCalculatedPrice.$calculatorType ?>)</p>
                    </span>
                    <div class="color__block">
                        <span class="color_label">
                            <?= $escaper->escapeHtml(__('Color:')) ?>
                        </span>
                        <?php if ($getSwatchImage && !$isSampleProduct) { ?>
                            <p class="color-display-name"><?php echo $colorDisplayName;?></p>
                        <?php } ?>
                    </div>
                    <?php if (!$isCbcProduct && $options = $block->getOptionList()): ?>
                        <dl class="item-options w-full break-all mt-1 clearfix">
                            <?php foreach ($options as $option): ?>
                                <?php
                                if (isset($option['option_id'])) {
                                    $attributeCode = $checkoutViewModel->getAttributeCodeById($option['option_id']);
