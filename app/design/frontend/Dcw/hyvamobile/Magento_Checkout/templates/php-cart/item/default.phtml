                                }
                                
                                $skipLabels = [
                                    'Colors',
                                    'Select An Option',
                                    'Configurable Product Id',
                                    'Configurable Product Url',
                                    'Configurable Product Image',
                                    'Main Configurable Product Image',
                                    'Product Name',
                                    'Configurable Product SKU',
                                    'Configurable Product Category',
                                    'Configurable Product Name',
                                    'Color Display Name'
                                ];

                                if (in_array($option['label'], $skipLabels) || $isSampleProduct) {
                                    continue;
                                }
                            ?>
                                <?php $formatedOptionValue = $block->getFormatedOptionValue($option); ?>
                                <?php if($option['label']!=""){?>
                                <dt class="text-size14 font-semibold float-left clear-left mr-2 mb-2"><?= $escaper->escapeHtml($option['label']) ?>:</dt>
                                <?php }  else {?>
                                <dt class="text-size14 font-semibold float-left clear-left mb-2 no-labels"></dt>
                                <?php } ?>
                                <dd class="float-left text-size14">
                                    <a class="action action-edit"
                                    href="<?= $escaper->escapeUrl($optionurl) ?>"
                                    title="<?= $escaper->escapeHtml($option['label']) ?>"
                                    >
                                    <?php if (isset($formatedOptionValue['full_view'])): ?>
                                            <?= $escaper->escapeHtml($formatedOptionValue['full_view']) ?>
                                        <?php else: ?>
                                            <?= $escaper->escapeHtml($formatedOptionValue['value'], ['span', 'a']) ?>
                                    <?php endif; ?>
                                    </a>
                                </dd>
                            <?php endforeach; ?>
                        </dl>
                    <?php endif;?>
                    
                    <?php if ($isSampleProduct) { ?>
                        <p class="sampleproduct-date text-size10 text-black font-normal"><?= $escaper->escapeHtml(__('Estimated Ship Date: 8–10 business days')) ?></p>
                    <?php } ?>

                    <?php if ($item && $item->getPdpLineItem()) {
                        $pdpLineItem = json_decode($item->getPdpLineItem(), true);
                        $itemRoomLength = $pdpLineItem['RoomLength'] ?? '';
                        $getCalculatorType = $loadChildProduct->getAttributeText('incstores_pim_calculator_type');
                        $isRollProduct = false;
                        if ($itemRoomLength && $getCalculatorType == 'roll') {
                            $isRollProduct = true;
                            $productCurrentAvailableQty = $flooringCalculationViewModelData->getProductCurrentAvailableQty($loadChildProduct->getId());
                            $itemQty = $itemRoomLength * $item->getQty();

                            $promiseDateText = "";
                            $promiseDate = $loadChildProduct->getIncstoresPimPromiseDate() ?? '';

                            if ($promiseDate) {
                                $promiseDateText = '[Estimated ship date: '.$promiseDate.']';
                            }

                            if ($itemQty > $productCurrentAvailableQty) { ?>
                                <div class= "cart item message notice">
                                    <div><?= $escaper->escapeHtml(__(
                                        'We have %1 in stock, and pre-orders will ship soon. Contact us at
                                            866-416-6388 with any questions! %2',
                                        $productCurrentAvailableQty,
                                        $promiseDateText
                                    )); ?></div>
                                </div>
                            <?php }
                        }
                    }
                    ?>

                    <?php if ($messages = $block->getMessages()): ?>
                        <?php foreach ($messages as $message) : ?>
                            <?php
                            $messageText = $message['text'] ?? '';
                            if ($messageText instanceof \Magento\Framework\Phrase) {
                                $messageText = $messageText->render();
                            }
                            if (!is_string($messageText)) {
                                $messageText = (string) $messageText;
                            }
                            if ($messageText !== '' && stripos($messageText, 'pre-orders will ship soon') !== false && $isRollProduct) {
                                continue;
                            }
                            ?>
                            <div class= "cart item message <?= $escaper->escapeHtmlAttr($message['type']) ?>">
                                <div><?= $escaper->escapeHtml($message['text']) ?></div>
                            </div>
                        <?php endforeach; ?>
                    <?php endif; ?>
                    <?php $addInfoBlock = $block->getProductAdditionalInformationBlock(); ?>
                    <?php if ($addInfoBlock): ?>
                        <?= $addInfoBlock->setItem($item)->toHtml() ?>
                    <?php endif;?>
                </div>
                <div class="col price pt-1 block w-full flex hidden">
                    <span class="lg:hidden text-size14 mr-2" style="line-height:25px;color:#252525;">
                        <?= $escaper->escapeHtml(__('Price :')) ?>
                    </span>
                    <?= $block->getUnitPriceHtml($item) ?>
                </div>                                                        
            </div>
            <div class="cart__right">
                <div class="col subtotal block text-right">
                    <span class="sr-only" style="color:#252525;">
                        <?= $escaper->escapeHtml(__('Subtotal :')) ?>
                    </span>
                    <?= $block->getRowTotalHtml($item) ?>
                    <?php if ($savePercentHtml) { ?>                
                        <p class="cut-price"><?php echo $cutPrice;?></p>
                        <p class="save-percentage"><?php echo $savePercentHtml;?></p>
                    <?php } ?>
                </div>
