			<?php if($productRowWeight!="" && $productRecycleFactor!="") {
                $intweight = intval($productRowWeight);
                $productRecycleFactor = intval($productRecycleFactor);
                $recyclevalue = $intweight / $productRecycleFactor;
            
                if($hero==1) { echo "<div class ='hero-text'>You're a hero! Your order keeps #".ceil($recyclevalue)." tire(s) out of landfills.</div>";}
			} ?>
