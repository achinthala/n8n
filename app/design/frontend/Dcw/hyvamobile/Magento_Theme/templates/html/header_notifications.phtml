$headerMobileTop = $this->getLayout()->createBlock('Magento\Cms\Block\Block')->setBlockId('header_mobile_top')->toHtml();

if($headerMobileTop != ''): ?>
    <div class="customer-satisfaction-container">
        <?php echo $headerMobileTop; ?>
