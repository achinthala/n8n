<?php
$helperdata = $this->helper('Dcw\FlooringCalculation\Helper\Data');
$mobileLimit = $helperdata->getMobileLimitCategory();
if (empty($mobileLimit)) {
    $mobileLimit = 50;
}
$placeHolderImage = $helperdata->getPlaceHolderImage();
$placeHolderImageSrc =  $helperdata->getImageUrl($placeHolderImage);
$categoryCollection = $helperdata->getCategoryCollection('featured_categories');
$noOfItems = $categoryCollection->count();
if ($noOfItems > 0) { ?>
    <?php $shopByCategoryHeading = $this->getLayout()->createBlock('Magento\Cms\Block\Block')->setBlockId('shop_by_category_heading')->toHtml(); ?>
    <?php if($shopByCategoryHeading != ''): ?>
        <?php echo $shopByCategoryHeading; ?>
    <?php endif; ?>
    <div class="outer shopbycategory" x-data="shopbyCategoryAjaxCall()" x-init="initShopbyCategoryFunc()" x-intersect.half="shopByCategoryShown = true">
        <template x-if="shopByCategoryShown">
            <div class="inner" :class="{ 'crossed': categoriesItemCount > 8 }">
                <template x-for="item in categories.items">
                    <div class="category_box">
                        <a x-bind:href="BASE_URL+item.url_path+item.url_suffix">
                            <img x-show="item.image" x-bind:src="item.image+'?width=155'" x-bind:alt="item.name" x-bind:title="item.name" width="181" height="107" loading="lazy" fetchpriority="low" decoding="async"/>
                            <img x-show="!item.image" src="<?= /* @noEscape */ $placeHolderImageSrc;?>" x-bind:alt="item.name" x-bind:title="item.name" width="181" height="107" loading="lazy" fetchpriority="low" decoding="async"/>
                            <h2 x-html="item.name" x-bind:title="item.name"></h2>
                        </a>
                    </div>
                </template>
                <a class="underline text-center text-size14 font-medium text-black w-full"
                x-on:click="document.querySelector('.inner').classList.remove('crossed');
                document.querySelector('.inner').classList.add('limited')">Show All</a>
            </div>
        </template>
    </div>
    <?php
    $bodyData = '{categories(filters: {featured_categories: {eq:1}} pageSize:'.$mobileLimit.')'.
    '{items{name image url_path url_suffix sort_by_featured_partner featured_categories}}}';
    ?>
    <script>
        function shopbyCategoryAjaxCall() {
            return {
                shopByCategoryShown: false,
                categories:'',
                categoriesItemCount:0,
                initShopbyCategoryFunc: function () {
                    fetch(BASE_URL+'graphql?form_key=' + hyva.getFormKey(), {
                        method: "POST",
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ query:'<?= /* @noEscape */ $bodyData?>'}),
                    })
                    .then(response => {
                        if (! response.ok) console.warn('GET request failed');
                        return response.json();
                    })
                    .then(data => {
                        if (data && data.data && data.data.categories) {
                            this.categories = data.data.categories;
                            this.categoriesItemCount = data.data.categories.items ? data.data.categories.items.length : 0;
                            if (this.categories.items && this.categories.items.length > 0) {
                                // Sort categories by sort_by_featured_partner
                                this.categories.items.sort((a, b) => {
                                    let fa = a['sort_by_featured_partner'] ?? 0,
                                        fb = b['sort_by_featured_partner'] ?? 0;

                                    if (fa < fb) {
                                        return -1;
                                    }
                                    if (fa > fb) {
                                        return 1;
                                    }
                                    return 0;
                                });
                            }
                        }
                    })
                    .finally(() => {
                        // Final sort - ensure all categories are included, handle null/undefined values
                        if (this.categories && this.categories.items && this.categories.items.length > 0) {
                            this.categories.items.sort((a, b) => {
                                let fa = a['sort_by_featured_partner'] ?? 0,
                                    fb = b['sort_by_featured_partner'] ?? 0;
                                // Sort only if both have valid numeric values
                                if (fa && fb) {
                                    return fa > fb ? 1 : (fa < fb ? -1 : 0);
                                }
                                // If one is null/0, maintain original order (don't filter out)
                                return 0;
                            });
                        }
                    });
                }
            }
        }
    </script>
<?php } ?>
