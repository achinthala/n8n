<?xml version="1.0"?>
<page layout="1column" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="header.panel.wrapper">
            <block class="Magento\Framework\View\Element\Template" name="header_notifications" template="Magento_Theme::html/header_notifications.phtml"/>
        </referenceContainer>

        <referenceBlock name="custom.fonts" remove="true" />
        <referenceBlock name="head.additional">
            <block class="Magento\Framework\View\Element\Template" name="preload" template="Magento_Theme::preload.phtml"/>
        </referenceBlock>
    </body>
</page>