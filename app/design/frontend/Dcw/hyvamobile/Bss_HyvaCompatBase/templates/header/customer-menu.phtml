use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\CustomerRegistration;
use Magento\Customer\Block\Account\Customer;
use Magento\Framework\Escaper;
use Hyva\Theme\ViewModel\Customer as CustomerNew;
use Dcw\Custom\ViewModel\Data as CustomViewModel;

/** @var Customer $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var CustomerRegistration $customerRegistration */
$customerRegistration = $viewModels->require(CustomerRegistration::class);

$customer = $viewModels->require(CustomerNew::class);
/** @var CustomViewModel $customViewModel */
$customViewModel = $viewModels->require(CustomViewModel::class);
$customerSession = $customViewModel->getCustomerSession();
?>

<div x-data="{ open: false }" class="relative inline-block ml-1 pr-4">
    <a
        href="<?= $escaper->escapeHtmlAttr($escaper->escapeUrl($block->getUrl('customer/account'))) ?>"
        id="customer-menu"
        class="block hover:text-black dropdown-acc"
        <?php if (!$customer->customerLoggedIn()): ?>
            @click.prevent="$dispatch('popup-register',
                { open: true,openRegister : false,openLogin : true,openCreate :true,
                openButtonLogin :true,
                openButtonRegister :false,
            })"
        <?php else: ?>
            @click.prevent="open = true"
        <?php endif ?>
        :aria-expanded="open ? 'true' : 'false'"
        aria-label="<?= $escaper->escapeHtmlAttr(__('My Account')) ?>"
    >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"
             class="image-att" aria-hidden="true">
            <circle fill="none" cx="12" cy="7" r="3"></circle>
            <path d="M12 2C9.243 2 7 4.243 7 7s2.243 5 5 5 5-2.243 5-5S14.757 2 12 2zM12 10c-1.654
                0-3-1.346-3-3s1.346-3 3-3 3 1.346 3 3S13.654 10 12 10zM21 21v-1c0-3.859-3.141-7-7-7h-4c-3.86
                0-7 3.141-7 7v1h2v-1c0-2.757 2.243-5 5-5h4c2.757 0 5 2.243 5 5v1H21z">
            </path>
        </svg>
    </a>
    <nav class="absolute right-0 z-20 hidden w-40 py-2 mt-2 -mr-4 px-1 overflow-auto origin-top-right rounded-sm
        shadow-lg sm:w-48 lg:mt-3 bg-container-lighter mob-dropdown"
         :class="{ 'hidden' : !open }"
         @click.outside="open = false"
         x-cloak x-show="open"
         aria-labelledby="customer-menu"
    >
        <?php if ($block->customerLoggedIn()): ?>
            <div class="l-name px-4 py-2">
            <?= $escaper->escapeHtmlAttr(__('Hello, ')) ?><?php echo $customerSession->getCustomer()->getName(); ?>
        </div>
            <?= $block->getChildHtml('customer_logged-menu') ?>
        <?php else: ?>
            <?= $block->getChildHtml('customer_not-login-menu') ?>
        <?php endif; ?>
    </nav>
</div>
