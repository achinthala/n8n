<script type="text/javascript">
    require(['jquery', 'jquery/ui', 'domReady!'], function ($) {
        $(document).ready(function() {
            $(document).on('click', function() {
                $('.billing-address-form .input-text').each(function () {
                    if ($(this).val()!='') {
                        $(this).parent().addClass('has-value');
                    } else {
                        $(this).parent().removeClass('has-value');
                    }
                });
            });

            $(document).on('change keyup','.billing-address-form .input-text', function() {
                if ($(this).val()!='') {
                    $(this).parent().addClass('has-value');
                } else {
                    $(this).parent().removeClass('has-value');
                }
            });

            function samplePaymentPage() {
                setTimeout(function () {
                    var bodyElement = document.body;
                    if (bodyElement.classList.contains('shipping-step')) {
                        bodyElement.classList.remove('payment-step');
                        bodyElement.classList.remove('sample-payment');
                    } else if (!bodyElement.classList.contains('shipping-step') || !bodyElement.classList.contains('payment-step')) {
                        bodyElement.classList.add('payment-step');
                        bodyElement.classList.add('sample-payment');
                    } else {

                    }
                }, 5000);
            }

            samplePaymentPage();

            var CHECKOUT_PAYMENT_INTERVAL = setInterval(function(){
                if($('#authnetcim-payment #authnetcim').length > 0){
                    if($('.all-payments-container .payment-method._active').length > 0) {
                    } else {
                        $('#authnetcim-payment #authnetcim').trigger('click');
                    }
                    clearInterval(CHECKOUT_PAYMENT_INTERVAL);
                }
            }, 200);
        });
    });
</script>
