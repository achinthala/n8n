<script>
    function splitPaymentSubmitFunc(){
        if (document.getElementById('split-payment')) {
            document.getElementById('split-payment').remove();
        }
        /** @type HTMLIFrameElement payIframe */
        var payIframe = document.createElement('iframe');
        var payIframeCloseBtn = document.getElementById('split-close');
        var type = event.currentTarget.dataset.type;
        jQuery('.loading-mask').trigger('processStart');

        document.body.style.overflow = 'hidden';
        payIframe.id = 'split-payment';
        payIframe.sandbox = 'allow-same-origin allow-top-navigation allow-scripts allow-forms';
        payIframe.src = BASE_URL + 'splitpayment';
        payIframe.style.display = 'block';
        // Add to document after #checkout element
        const checkoutElement = document.getElementById('checkout');
        if (checkoutElement) {
            checkoutElement.after(payIframe);
        }

        payIframeCloseBtn.style.display = 'block';
        setTimeout(function () {
            jQuery('.loading-mask').trigger('processStop');
        }, 700);
    }

    require(['jquery'],function($){
        $(function() {
            $('#split-close').on('click', function () {
                if (confirm('Do you close the Split Payments?')) {
                    document.body.style.overflow = '';
                    $('#split-payment').hide();
                    $('#split-close').hide();
                    $('#split-payment').attr('src', '');
                }
            });
        })
    });
</script>

<script>
    require(['jquery', 'jquery/ui', 'domReady!'], function ($) {
        $(document).ready(function () {
            function updateInputClass() {
                setTimeout(function () {
                    $('.checkout-shipping-address .input-text, #shipping-new-address-form .input-text').each(function () {
                        if ($(this).val() != '') {
                            $(this).removeClass('empty-field').addClass('has-value');
                            $(this).parent().removeClass('empty-field').addClass('has-value');
                            $(this).parent().parent().removeClass('empty-field').addClass('has-value');
                            $(this).removeClass('empty').addClass('has-value');
                        } else {
                            $(this).parent().removeClass('has-value').addClass('empty-field');
                            $(this).parent().parent().removeClass('has-value').addClass('empty-field');
                            if(($(this)[0].name!="company") && ($(this)[0].name!="street[1]") && ($(this)[0].name!="custom_attributes[phone_ext]")){
                            $(this).removeClass('has-value').addClass('empty');
                            }
                        }
                    });

                    if ($("#shipping-new-address-form").parent().find('.empty').length != 0) {
                        $('.shipping-new-address-form .continue').prop('disabled', true);
                    } else {
                        $('.shipping-new-address-form .continue').prop('disabled', false);
                    }

                    $('input[name$="telephone"]').attr('type','number');
                    $('input[name$="postcode"]').attr('type','number');

                    if ($(".shipping-address-items").parent().find('.selected-item').length != 0) {
                        $('.shipping-new-address-form .continue').prop('disabled', false);
                    }
                    updateInputClass();
                }, 0);
            }
            updateInputClass();
            $(window).load(function() {
                updateInputClass();
                console.info('loaded');
            });
        });
    });
</script>

