<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        function setupPayFlow() {
            var payFlowElement = document.getElementById('payflowpro');
            var authnetCimPayment = document.getElementById('authnetcim-payment');
            if (payFlowElement && authnetCimPayment) {
                var paymentMethodElement = payFlowElement.closest('.payment-method');
                if (paymentMethodElement) {
                    paymentMethodElement.id = 'pay__flow__method';
                    authnetCimPayment.insertAdjacentElement('afterend', paymentMethodElement);

                    function toggleAuthnetCimClass() {
                        if (paymentMethodElement.classList.contains('_active')) {
                            authnetCimPayment.classList.add('active');
                        } else {
                            authnetCimPayment.classList.remove('active');
                        }
                    }
                    var observer = new MutationObserver(toggleAuthnetCimClass);
                    observer.observe(paymentMethodElement, { attributes: true, attributeFilter: ['class'] });
                    toggleAuthnetCimClass();
                    clearInterval(checkInterval);
                }
            }
        }
        setupPayFlow();
        var checkInterval = setInterval(setupPayFlow, 500);
    });
</script>

<script>
    function logOutClass() {
        if (document.querySelector('.lac-notification')) {
            document.body.classList.add('customer-logged-in');
        } else {
            document.body.classList.remove('customer-logged-in');
        }
    }
    logOutClass();
    const observer = new MutationObserver(logOutClass);
    observer.observe(document.body, { childList: true, subtree: true });
</script>
<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        function purchaseOrderCheck() {
            var purchaseOrderMethod = document.querySelector('.purchase-order-payment-method') || document.getElementById('purchaseorder-payment');
            var paymentGroup = document.querySelector('.payment-group');
            if (purchaseOrderMethod && paymentGroup) {
                paymentGroup.classList.add('purchase__order__method');
                clearInterval(checkInterval);
            }
        }
        var checkInterval = setInterval(purchaseOrderCheck, 500);
    });
</script>