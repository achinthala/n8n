<script>
        function onlyNumberKey(evt) {
            var ASCIICode = (evt.which) ? evt.which : evt.keyCode;

            // If Enter key is pressed, trigger submitForm (so threshold popup / discount removal flow runs)
            if (ASCIICode === 13) {
                evt.preventDefault();
                if (typeof submitForm === 'function') {
                    submitForm();
                }
                return false;
            }

            // Only ASCII digits 0–9 allowed
            if (ASCIICode > 31 && (ASCIICode < 48 || ASCIICode > 57)) {
                return false;
            }
            return true;
        }
    </script>
    <script>
        var myForm = document.getElementById("form-validate");
        function submitForm(){
            // Skip update if no qty actually changed (avoids threshold/discount popup on blur without edit)
            var qtyInputs = document.querySelectorAll('input[data-role="cart-item-qty"][data-original-qty]');
            var hasQtyChange = false;
            for (var i = 0; i < qtyInputs.length; i++) {
                var inp = qtyInputs[i];
                var orig = inp.getAttribute('data-original-qty');
                var current = (inp.value || '').trim();
                if (orig !== null && current !== orig) {
                    hasQtyChange = true;
                    break;
                }
            }
            if (!hasQtyChange) {
                return;
            }

            window.dispatchEvent(new CustomEvent('amcart-loading-start'));
            const cartId = <?= $item->getId(); ?>;
            const postUrl = '<?= $escaper->escapeUrl($block->getUrl('amasty_quote/cart/updatePost')) ?>';
            const formKey = document.querySelector('input[name=form_key]').value;
            const form = document.getElementById('form-validate');

            // Prevent the native form submit (which causes full page reload and plain error message)
            form.onsubmit = function (e) {
                e.preventDefault();
            };

            const requestBody = new URLSearchParams(new FormData(form)).toString() + '&update_cart_action=update_qty';

            function doUpdate(bodyToSend) {
                return fetch(postUrl, {
                    "headers": {
                        "content-type": "application/x-www-form-urlencoded; charset=UTF-8",
                        "X-Requested-With": "XMLHttpRequest"
                    },
                    "method": "POST",
                    "mode": "cors",
                    "credentials": "include",
                    "body": new URLSearchParams(bodyToSend)
                }).then((response) => {
                    const contentType = response.headers.get('content-type');
                    if (contentType && contentType.includes('application/json')) {
                        return response.json();
                    }
                    // Non-JSON: just stop loading
                    window.dispatchEvent(new CustomEvent('amcart-loading-stop'));
                    return null;
                });
            }

            doUpdate(requestBody).then((data) => {
                if (!data) {
                    return;
                }

                // Threshold popup: discount removal
                if (data.show_discount_removal_popup) {
                    window.dispatchEvent(new CustomEvent('amcart-loading-stop'));
                    const quoteId = data.quote_id || null;

                    (typeof showDiscountRemovalModal === 'function' ? showDiscountRemovalModal() : Promise.resolve(true)).then((proceed) => {
                    if (proceed) {
                        // Remove discount then retry qty update
                        window.dispatchEvent(new CustomEvent('amcart-loading-start'));
                        const removeDiscountUrl = '<?= $escaper->escapeUrl($block->getUrl('dcwrequestquote/cart/removeDiscount')) ?>';
                        const params = new URLSearchParams();
                        if (quoteId) {
                            params.append('quote_id', quoteId);
                        }
                        if (formKey) {
                            params.append('form_key', formKey);
                        }

                        fetch(removeDiscountUrl, {
                            "headers": {
                                "content-type": "application/x-www-form-urlencoded; charset=UTF-8",
                                "X-Requested-With": "XMLHttpRequest"
                            },
                            "method": "POST",
                            "mode": "cors",
                            "credentials": "include",
                            "body": params.toString()
                        }).then((res) => {
                            const ct = res.headers.get('content-type');
                            if (ct && ct.includes('application/json')) {
                                return res.json();
                            }
                            return { success: true };
                        }).then((removeData) => {
                            if (removeData && removeData.error) {
                                throw new Error(removeData.message || 'Failed to remove discount');
                            }
                            // Retry qty update with same body
                            return doUpdate(requestBody);
                        }).then((retryData) => {
                            window.dispatchEvent(new CustomEvent('amcart-loading-stop'));
                            if (retryData && (retryData.errors || retryData.error)) {
                                const msg = retryData.message || retryData.error || 'An error occurred while updating quantities';
                                if (window.dispatchMessages) {
                                    window.dispatchMessages([{ type: 'error', text: msg }]);
                                } else {
                                    alert(msg);
                                }
                                return;
                            }
                            // Success after retry – keep user on page, sections can be reloaded elsewhere if needed
                        }).catch((err) => {
                            window.dispatchEvent(new CustomEvent('amcart-loading-stop'));
                            const msg = err && err.message ? err.message : 'An error occurred while removing the discount.';
                            if (window.dispatchMessages) {
                                window.dispatchMessages([{ type: 'error', text: msg }]);
                            } else {
                                alert(msg);
                            }
                        });
                        return;
                    } else {
                        // User chose Keep My Discount - revert qty inputs to original values
                        var qtyInputs = document.querySelectorAll('input[data-role="cart-item-qty"][data-original-qty]');
                        qtyInputs.forEach(function(inp) {
                            var orig = inp.getAttribute('data-original-qty');
                            if (orig !== null && orig !== '') {
                                inp.value = orig;
                            }
                        });
                        if (window.dispatchMessages) {
                            window.dispatchMessages([{
                                type: 'info',
                                text: 'Update cancelled.'
                            }]);
                        }
                        window.dispatchEvent(new CustomEvent('amcart-loading-stop'));
                        return;
                    }
                    });
                }

                // Standard error JSON
                if (data.errors || data.error) {
                    window.dispatchEvent(new CustomEvent('amcart-loading-stop'));
                    const msg = data.message || data.error || 'An error occurred while updating quantities';
                    if (window.dispatchMessages) {
                        window.dispatchMessages([{ type: 'error', text: msg }]);
                    } else {
                        alert(msg);
                    }
                    return;
                }

                // Success – just stop loading, stay on page
                window.dispatchEvent(new CustomEvent('amcart-loading-stop'));
            }).catch((err) => {
                window.dispatchEvent(new CustomEvent('amcart-loading-stop'));
                // Optional: handle error if needed
            });
        }
        function detailssubmit() {
            alert("Your details were Submitted");
        }
    </script>