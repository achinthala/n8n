<script>
function showDiscountRemovalModal() {
    return new Promise(function(resolve) {
        var modal = document.getElementById('discount-removal-modal');
        if (!modal) { resolve(false); return; }
        modal.style.display = 'flex';
        var keepBtn = document.getElementById('discount-modal-keep');
        var continueBtn = document.getElementById('discount-modal-continue');
        function close(proceed) {
            modal.style.display = 'none';
            keepBtn.removeEventListener('click', onKeep);
            continueBtn.removeEventListener('click', onContinue);
            resolve(proceed);
        }
        function onKeep() { close(false); }
        function onContinue() { close(true); }
        keepBtn.addEventListener('click', onKeep);
        continueBtn.addEventListener('click', onContinue);
    });
}

function onlyNumberKey(evt) {
    // Only ASCII character in that range allowed
    var ASCIICode = (evt.which) ? evt.which : evt.keyCode
    if (ASCIICode > 31 && (ASCIICode < 48 || ASCIICode > 57))
        return false;
    return true;
}

var myForm = document.getElementById("form-validate");

function submitForm() {
    if (!myForm) {
        return;
    }

    // Skip update if no qty actually changed (avoids threshold/discount popup on blur without edit)
    var qtyInputs = document.querySelectorAll('input[data-role="cart-item-qty"][data-original-qty]');
    var hasQtyChange = false;
    for (var i = 0; i < qtyInputs.length; i++) {
        var inp = qtyInputs[i];
        var orig = inp.getAttribute('data-original-qty');
        var current = (inp.value || '').trim();
        if (orig !== null && current !== orig) {
            hasQtyChange = true;
            break;
        }
    }
    if (!hasQtyChange) {
        return;
    }

    // Prevent native form submit (full page reload)
    myForm.onsubmit = function (e) {
        e.preventDefault();
    };

    var postUrl = myForm.getAttribute('action') || '<?= $escaper->escapeUrl($block->getUrl('checkout/cart/updatePost')) ?>';
    var formKeyInput = document.querySelector('input[name="form_key"]');
    var formKey = formKeyInput ? formKeyInput.value : '';

    // Build body with update_cart_action=update_qty (same as core)
    var body = new URLSearchParams(new FormData(myForm)).toString() + '&update_cart_action=update_qty';

    // Show global loader when starting qty update
    window.dispatchEvent(new CustomEvent('amcart-loading-start'));

    function doUpdate(bodyToSend) {
        return fetch(postUrl, {
            headers: {
                'content-type': 'application/x-www-form-urlencoded; charset=UTF-8',
                'X-Requested-With': 'XMLHttpRequest'
            },
            method: 'POST',
            mode: 'cors',
            credentials: 'include',
            body: bodyToSend
        }).then(function (response) {
            var contentType = response.headers.get('content-type');
            if (contentType && contentType.indexOf('application/json') !== -1) {
                return response.json();
            }
            // Non-JSON: fall back to normal behaviour
            window.dispatchEvent(new CustomEvent('amcart-loading-stop'));
            window.location.reload();
            return null;
        });
    }

    doUpdate(body).then(function (data) {
        if (!data) {
            window.dispatchEvent(new CustomEvent('amcart-loading-stop'));
            return;
        }

        // Threshold popup: discount removal requested by plugin
        if (data.show_discount_removal_popup) {
            var quoteId = data.quote_id || null;

            showDiscountRemovalModal().then(function(proceed) {
            if (proceed) {
                // User confirmed – show loader while discount is being removed
                window.dispatchEvent(new CustomEvent('amcart-loading-start'));

                var removeDiscountUrl = '<?= $escaper->escapeUrl($block->getUrl('dcwrequestquote/cart/removeDiscount')) ?>';
                var params = new URLSearchParams();
                if (quoteId) {
                    params.append('quote_id', quoteId);
                }
                if (formKey) {
                    params.append('form_key', formKey);
                }

                return fetch(removeDiscountUrl, {
                    headers: {
                        'content-type': 'application/x-www-form-urlencoded; charset=UTF-8',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    method: 'POST',
                    mode: 'cors',
                    credentials: 'include',
                    body: params.toString()
                }).then(function (res) {
                    var ct = res.headers.get('content-type');
                    if (ct && ct.indexOf('application/json') !== -1) {
                        return res.json();
                    }
                    return { success: true };
                }).then(function (removeData) {
                    if (removeData && removeData.error) {
                        throw new Error(removeData.message || 'Failed to remove discount');
                    }
                    // Retry qty update after discount removal
                    return doUpdate(body);
                }).then(function (retryData) {
                    if (retryData && (retryData.errors || retryData.error)) {
                        var msg = retryData.message || retryData.error || 'An error occurred while updating quantities';
                        if (window.dispatchMessages) {
                            window.dispatchMessages([{ type: 'error', text: msg }]);
                        } else {
                            alert(msg);
                        }
                        return;
                    }
                    // Success after retry – reload to refresh cart
                    window.dispatchEvent(new CustomEvent('amcart-loading-stop'));
                    window.location.reload();
                }).catch(function (err) {
                    console.error('Error in discount removal flow (checkout/cart/updatePost)', err);
                    var msg = err && err.message ? err.message : 'An error occurred while removing the discount.';
                    if (window.dispatchMessages) {
                        window.dispatchMessages([{ type: 'error', text: msg }]);
                    } else {
                        alert(msg);
                    }
                    window.dispatchEvent(new CustomEvent('amcart-loading-stop'));
                });
            } else {
                // User chose Keep My Discount - cancel the update and revert qty inputs to original values
                var qtyInputs = document.querySelectorAll('input[data-role="cart-item-qty"][data-original-qty]');
                qtyInputs.forEach(function(inp) {
                    var orig = inp.getAttribute('data-original-qty');
                    if (orig !== null && orig !== '') {
                        inp.value = orig;
                    }
                });
                if (window.dispatchMessages) {
                    window.dispatchMessages([{
                        type: 'info',
                        text: 'Update cancelled.'
                    }]);
                }
                window.dispatchEvent(new CustomEvent('amcart-loading-stop'));
            }
            });
            return;
        }

        // Standard error JSON
        if (data.errors || data.error) {
            var msg2 = data.message || data.error || 'An error occurred while updating quantities';
            if (window.dispatchMessages) {
                window.dispatchMessages([{ type: 'error', text: msg2 }]);
            } else {
                alert(msg2);
            }
            window.dispatchEvent(new CustomEvent('amcart-loading-stop'));
            return;
        }

        // Success – reload cart to show updated totals
        window.dispatchEvent(new CustomEvent('amcart-loading-stop'));
        window.location.reload();
    }).catch(function (err) {
        console.error('checkout/cart/updatePost qty update fetch error', err);
        window.dispatchEvent(new CustomEvent('amcart-loading-stop'));
    });
}

function detailssubmit() {
    alert("Your details were Submitted");
}
</script>
