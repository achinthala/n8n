    >
        <div
            class="modal-overlay fixed inset-0 bg-black/60"
            @click="closeModal()"
        ></div>
        <div class="modal-content relative z-10 w-full max-w-xl max-h-[90vh] overflow-y-auto rounded-md bg-white p-6 shadow-xl">
            <button
                type="button"
                class="closemodal absolute right-4 top-4 text-2xl leading-none text-gray-500 hover:text-gray-800"
                title="<?= $escaper->escapeHtml(__('Close')) ?>"
