</form>
<script>
    function faqQuestionsForm_<?= $escaper->escapeHtml($uniqueId) ?>() {
        const fieldCategory = 'category_ids';
        const fieldProduct = 'product_ids';
        return {
            isLoading: false,
            isLoggedIn: false,
            isShowForm: <?= $guestQuestionsAllowed ? 'true' : 'false' ?>,
            isSettingsReady: <?= $guestQuestionsAllowed ? 'true' : 'false' ?>,
            isFormActive: false,
            formSettings: <?= /** @noEscape */ json_encode($formSettingsDefaults) ?>,
            _syncCustomerDataFromStorage() {
                try {
                    const storage = localStorage.getItem('mage-cache-storage');
                    if (!storage) {
                        return;
                    }
                    const parsed = JSON.parse(storage);
                    if (parsed?.customer?.firstname) {
                        this.isLoggedIn = true;
                    }
                    if (parsed?.faq?.name) {
                        this.userName = parsed.faq.name;
                        this.userEmail = parsed.faq.email || '';
                    }
                } catch (e) {
                    // Ignore parse errors
                }
            },
            // Check login status immediately from cookies/localStorage if available
            _checkLoginStatus() {
                // Try to check if user is logged in by looking for customer data indicators
                // This is a fallback until private-content-loaded event fires
                try {
                    // Check if there's a customer token or session indicator
                    const customerData = window.customerData || window.localStorage?.getItem('mage-cache-storage');
                    if (customerData) {
                        try {
                            const parsed = typeof customerData === 'string' ? JSON.parse(customerData) : customerData;
                            if (parsed?.customer?.firstname) {
                                this.isLoggedIn = true;
                            }
                        } catch (e) {
                            // Ignore parse errors
                        }
                    }
                } catch (e) {
                    // Ignore errors
                }
            },
            isNotifyUser: <?= $block->isNotifyUser() ? 'true' : 'false' ?>,
            additionalField: <?= /** @noEscape */ json_encode($additionalField) ?>,
            isNameFieldEnabled: false,
            isEmailFieldEnabled: true,
            formKey: hyva.getFormKey(),
            userQuestion: '',
            userName: '',
            userEmail: '',
            getCaptchaEnabled: <?= $viewModelQuestions->getCaptchaEnabled() ? 'true' : 'false' ?>,
            isFaqFormToProtect: false,
            gcaptchaToken: '',
            allowedCaptchaForm: '<?= $escaper->escapeJs(implode(',', $viewModelCaptcha->getAllFormSelectors())) ?>',
            verifyUrl: '<?= $escaper->escapeJs($viewModelQuestions->getVerifyUrl())?>',
            isFormReadyToSubmit: false,
            isFormVerifiedByCaptcha: true,
            validateEmailsRegex: /^([a-z0-9,!\#\$%&'\*\+\/=\?\^_`\{\|\}~-]|[\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF])+(\.([a-z0-9,!\#\$%&'\*\+\/=\?\^_`\{\|\}~-]|[\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF])+)*@([a-z0-9-]|[\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF])+(\.([a-z0-9-]|[\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF])+)*\.(([a-z]|[\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF]){2,})$/i,
            queries: {
                getAmFaqSettings: <?= /** @noEscape */ json_encode(
                    $viewModelGraphQl->query(
                        'am_get_faq_settings',
                        'query getAmFaqSettings {'
                        . $viewModelQueries->getAmFaqSettings() .
                        '}'
                    )
                ) //phpcs:ignore ?>,
                placeAmFaqQuestion: <?= /** @noEscape */ json_encode(
                    $viewModelGraphQl->query(
                        'am_place_faq_question',
                        'mutation placeAmFaqQuestion($title: String!, $name: String, $email: String, $product_id: Int, $category_id: Int) {'
                        . $viewModelQueries->getPlaceAmFaqQuestion() .
                        '}'
                    )
                ) //phpcs:ignore ?>,
            },

            initQuestionsForm() {
                this._checkLoginStatus();
                this._syncCustomerDataFromStorage();
                this._applyFormVisibility();
                this._getAmFaqSettingsData();
                this._checkIsAllowCaptcha();
                this._listeners();
            },

            <?php /** Listeners for component actions (submit form, etc.) */ ?>
            _listeners() {
                <?php /* Submit form in case from allowed to submit */?>
                this.$watch('isFormReadyToSubmit', (isReady) => {
                    if (isReady) {
                        this._placeQuestion();
                    }
                    this.isFormReadyToSubmit = false;
                })
            },

            openAskModal() {
                this.isFormActive = true;
                document.body.classList.add('overflow-hidden');
                this.$nextTick(() => {
                    const questionField = document.getElementById('amfaq-title');
                    if (questionField) {
                        questionField.focus();
                    }
                });
            },

            closeModal() {
                this.isFormActive = false;
                document.body.classList.remove('overflow-hidden');
            },

            receiveCustomerData(data) {
                this.isLoggedIn = !!(data.customer && data?.customer?.firstname);
                this._applyFormVisibility();

                const faqData = data.faq;

                if (faqData && faqData.name) {
                    this.userName = faqData.name;
                    this.userEmail = faqData.email;
                }

                this._getAmFaqSettingsData();
            },

            _applyFormVisibility() {
                if (!this.formSettings) {
                    return;
                }

                this.isShowForm = !(
                    !this.formSettings.isGuestQuestionsAllowed && !this.isLoggedIn
                );
            },

            <?php /** Form submit */?>
            submitQuestionForm() {
                <?php /* Captcha verifiaction and set flags for submit */?>
                if (this.getCaptchaEnabled && this.isFaqFormToProtect && this.gcaptchaToken) {
                    this._verifyGrecaptcha(this.gcaptchaToken);
                } else {
                    this.isFormReadyToSubmit = true;
                }
            },

            getCaptchaToken(form) {
                const tokenField = form.querySelector('.g-recaptcha-response');
                this.gcaptchaToken = tokenField ? tokenField.value : '';
            },

            validateForm(input) {
                const emails = input.value.split(/[\s\n\,]+/g);

                for (let i = 0; i < emails.length; i++) {
                    if (!this.validateEmailsRegex.test(emails[i].trim())) {
                        this.isValid = false;
                        input.setCustomValidity('<?= $escaper->escapeJs(__($validationLabel)) ?>');
                        return false;
                    }
                }
                this.isValid = true;
                input.setCustomValidity('');
                return true;
            },

            closeAndClearForm() {
                this.userQuestion = '';
                this.isNameFieldEnabled = false;
                this.isEmailFieldEnabled = true;
                this.closeModal();
            },

            _checkIsAllowCaptcha() {
                const faqFormSelector = 'form[action*="faq/index/save"]';
                Array.from(this.allowedCaptchaForm.split(',')).forEach(formSelector => {
                    if (formSelector === faqFormSelector) {
                        this.isFaqFormToProtect = true;
                    }
                })
            },

            <?php /** Send graphQL mutation for place question */?>
            _placeQuestion() {
                const data = this._prepareMutationData();
                this.isLoading = true;
                this._useQuery(
                    this.queries.placeAmFaqQuestion, data
                ).then(result => {
                    /* show errros */
                    if (result?.errors) {
                        console.error(result);
                        result.errors.map(error => {
                            this._showMessage(error.message, 'error', 5000);
                        });
                        return result;
                    }
                    /* get data */
                    const message = result?.data?.placeAmFaqQuestion?.message;
                    const messageType = result?.data?.placeAmFaqQuestion?.error ? 'error' : 'success';
                    this._showMessage(message, messageType, 10000);
                    this.closeAndClearForm();
                }).finally(() => {
                    this.isLoading = false;
                    this.$nextTick(() => {
                        this.$refs.formToggle.focus();
                    })
                });
            },

            <?php /** Amasty invisible verfication */ ?>
            _verifyGrecaptcha(token) {
                let url = this.verifyUrl;
                let requestData = '?token=' + token;
                fetch(url + requestData, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                })
                .then(response => response.json())
                .then(result => {
                    if (result?.success) {
                        if (result?.verification?.success) {
                            this.isFormReadyToSubmit = true;
                        } else {
                            this._showMessage(result?.verification?.error, 'error', 10000)
                            this.isFormReadyToSubmit = false;
                        }
                    } else {
                        console.error(result.error_message);
                        this._showMessage(result.error_message, 'error', 4000)
                    }
                })
            },

            _showMessage(message, type, delay) {
                dispatchMessages([{
                    type: type,
                    text: message
                }], delay);
            },

            _prepareMutationData() {
                let data = {
                    title: this.userQuestion,
                    name: this.userName,
                    email: this.userEmail
                }
                if (this.additionalField) {
					switch (this.additionalField.field) {
						case fieldCategory:
							data['category_id'] = parseInt(this.additionalField.value);
							break;
						case fieldProduct:
							data['product_id'] = parseInt(this.additionalField.value);
							break;
					}
				}
                return data;
            },

            _getAmFaqSettingsData() {
                this._useQuery(
                    this.queries.getAmFaqSettings
                ).then(result => {
                    if (result?.errors) {
                        console.error(result);
                        result.errors.map(error => {
                            this._showMessage(error.message, 'error', 5000);
                        });
                        return result;
                    }
                    this.formSettings = result?.data?.getAmFaqSettings;

                    this._checkLoginStatus();
                    this._syncCustomerDataFromStorage();
                    this.isSettingsReady = true;
                    this._applyFormVisibility();
                });
            },

            _useQuery(query, variables) {
                return fetch(BASE_URL + "graphql", {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Store': '<?= /* @noEscape */ $viewModelStore->getStoreCode() ?>'
                    },
                    credentials: 'include',
                    body: JSON.stringify({query: query, variables: variables}),
                }).then(response => response.json()).catch(() => {
                    this._showMessage('<?= $escaper->escapeHtml(__("Something went wrong. Please try again later.")) ?>', 'error', 5000);
                })
            }
        }
    }
</script>
