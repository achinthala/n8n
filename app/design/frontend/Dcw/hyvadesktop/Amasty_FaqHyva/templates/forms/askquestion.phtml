    <div
        class="modal amfaq-ask-question-popup fixed inset-0 z-[999] flex items-center justify-center p-4"
        x-show="isFormActive"
        x-cloak
        role="dialog"
        aria-modal="true"
        aria-labelledby="amfaq-ask-modal-title-<?= $escaper->escapeHtmlAttr($uniqueId) ?>"
