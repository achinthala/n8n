    </template>
    <template x-if="isShowForm">
        <div class="button-container flex items-center mt-3">
            <p class="button-info mr-4 text-lg font-light">
                <?= $escaper->escapeHtml(__('Did you find what you were looking for?')) ?>
            </p>
            <button type="button"
                    title="<?= $escaper->escapeHtml(__('Ask a Question')) ?>"
                    class="form-toggle-button action btn"
                    @click="openAskModal()"
                    x-ref="formToggle">
                <?= $escaper->escapeHtml(__('Ask a Question')) ?>
            </button>
        </div>
    </template>
