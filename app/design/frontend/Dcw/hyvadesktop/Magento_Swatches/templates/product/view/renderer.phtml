    <script>
        function initConfigurableSwatchOptions_<?= $productId ?>() {
            <?php if ($shipRegionEnabled): ?>
            if (typeof window.dcwEnsureShipRegionSwatchPatch === 'function') {
                window.dcwEnsureShipRegionSwatchPatch();
            }
            <?php endif; ?>
            const configurableOptionsComponent = initConfigurableOptions(
                '<?= $productId ?>',
                <?= /* @noEscape */ $block->getJsonConfig() ?>
            );
            <?php if (is_array($getQuickShipProductCount) && count($getQuickShipProductCount) > 0): ?>
            configurableOptionsComponent.optionConfig.quick_ship_color_ids = <?= /* @noEscape */ json_encode(array_values(array_map('strval', $getQuickShipProductCount))) ?>;
            <?php endif; ?>
            const swatchLabelValuesJson = <?= /* @noEscape */ ($swatchLabelValues !== '' ? $swatchLabelValues : '{}') ?>;
            const swatchOptionsComponent = initSwatchOptions(
                <?= /* @noEscape */ $block->getJsonSwatchConfig() ?>,
                swatchLabelValuesJson
            );

            const merged = Object.assign({}, configurableOptionsComponent, swatchOptionsComponent);
            merged.swatchLabelValues = (
                swatchOptionsComponent.swatchLabelValues
                && typeof swatchOptionsComponent.swatchLabelValues === 'object'
                && !Array.isArray(swatchOptionsComponent.swatchLabelValues)
            ) ? swatchOptionsComponent.swatchLabelValues : (
                swatchLabelValuesJson
                && typeof swatchLabelValuesJson === 'object'
                && !Array.isArray(swatchLabelValuesJson)
                ? swatchLabelValuesJson
                : {}
            );
            if (typeof merged.shipRegionShowInSection !== 'function') {
                merged.shipRegionShowInSection = function () {
                    return true;
                };
            }
            merged.shipRegionZipActive = merged.shipRegionZipActive ?? false;
            merged.customerRegionCode = merged.customerRegionCode ?? null;
            merged.ensureLegacyColorSwatchVisible = function () {
                if (this.shipRegionZipActive && this.customerRegionCode) {
                    return;
                }
                document.querySelectorAll('.normal_color_swatch_option .selectOptionContent').forEach(function (el) {
                    const parent = el.closest('.selectOptionColor');
                    if (parent && !parent.classList.contains('hidden')) {
                        el.classList.remove('sr-only');
                    }
                });
                if (typeof this.syncNormalColorSwatchQuickShipVisibility === 'function') {
                    this.syncNormalColorSwatchQuickShipVisibility();
                } else if (typeof this.syncNormalColorSwatchSectionVisibility === 'function') {
                    this.syncNormalColorSwatchSectionVisibility();
                }
            };
            merged._legacyColorSwatchImages = (function () {
                try {
                    const raw = <?= /* @noEscape */ ($swatchImageUrl !== '' ? $swatchImageUrl : '{}') ?>;
                    return raw && typeof raw === 'object' ? raw : {};
                } catch (error) {
                    return {};
                }
            })();
            const mergedInit = merged.init;
            merged.init = function () {
                if (typeof mergedInit === 'function') {
                    mergedInit.call(this);
                }
                const self = this;
                this.$nextTick(function () {
                    if (typeof self.syncConfigurableOptionSections === 'function') {
                        self.syncConfigurableOptionSections();
                    } else if (typeof self.ensureLegacyColorSwatchVisible === 'function') {
                        self.ensureLegacyColorSwatchVisible();
                    }
                });
                window.setTimeout(function () {
                    if (typeof self.syncConfigurableOptionSections === 'function') {
                        self.syncConfigurableOptionSections();
                    }
                }, 350);
            };
            return merged;
        }
    </script>

