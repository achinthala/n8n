<script>
    function equalHeight() {
        const swatchItems = document.querySelectorAll(
            '.swatch-attribute.other_swatch_option .swatch-attribute-options label.swatch-option'
        );
        if (!swatchItems.length) {
            return;
        }
        let maxHeight = 0;
        swatchItems.forEach(item => {
            item.style.height = 'auto';
        });
        swatchItems.forEach(item => {
            maxHeight = Math.max(maxHeight, item.offsetHeight);
        });
        swatchItems.forEach(item => {
            item.style.height = maxHeight + 'px';

        });
    }
    window.addEventListener('load', () => {
        setTimeout(equalHeight, 500);
    });
    window.addEventListener('resize', equalHeight);
</script>