<script>
    'use strict';
    function initSliderComponent() {
return {
    active: 0,
    itemCount: 0,
    pageSize: 6,
    pageFillers: 0,

    getSlider() {
        return this.$root.querySelector('.js_slides');
    },

    calcPageSize() {
        const slider = this.getSlider();
        if (!slider) return;

        this.itemCount = slider.querySelectorAll('.js_slide').length;
        this.pageFillers =
            (this.pageSize * Math.ceil(this.itemCount / this.pageSize))
            - this.itemCount;
    },

    calcActive() {
        const slider = this.getSlider();
        if (!slider) return;

        const slide = slider.querySelector('.js_slide');
        if (!slide) return;

        const pageWidth = slide.offsetWidth * this.pageSize;
        this.active = Math.round(slider.scrollLeft / pageWidth) * this.pageSize;
    },

    scrollPrevious() {
        this.scrollToPage((this.active / this.pageSize) - 1);
    },

    scrollNext() {
        this.scrollToPage((this.active / this.pageSize) + 1);
    },

    scrollToPage(page) {
        const slider = this.getSlider();
        if (!slider) return;

        const slide = slider.querySelector('.js_slide');
        if (!slide) return;

        const totalPages = Math.ceil(this.itemCount / this.pageSize);
        const safePage = Math.max(0, Math.min(page, totalPages - 1));

        const pageWidth = slide.offsetWidth * this.pageSize;

        slider.scrollLeft = pageWidth * safePage;
        this.active = safePage * this.pageSize;
    }
}

    }
</script>
