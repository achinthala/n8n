            <script>
                function initPriceBox_<?= (int)$productId ?>() {
                    return {
                        showSecondaryPrice: <?= $showSecondaryPrice ? 'true' : 'false' ?>,
                        coveragePerCase: <?= (float)$coveragePerCase ?>,
                        sqftPerTile: <?= (float)$sqftPerTile ?>,
                        secondaryPriceFormatted: '<?= /* @noEscape */ $escaper->escapeJs($secondaryPriceFormatted) ?>',
                        secondaryPriceOldFormatted: '<?= /* @noEscape */ $escaper->escapeJs($secondaryPriceOldFormatted ?? '') ?>',
                        secondaryPriceLabel: '<?= /* @noEscape */ $escaper->escapeJs($secondaryPriceLabel) ?>',
                        updatePrice(priceData) {
                            if (!priceData || !priceData.finalPrice || typeof priceData.finalPrice.amount === 'undefined') return;
                            const root = this.$root;
                            const cov = parseFloat(priceData.getIncstoresPimCoverage) || 0;
                            const calcType = (priceData.calculatorType || '').toLowerCase();
                            const exactWidth = parseFloat(priceData.exactWidth) || 0;
                            const exactLength = parseFloat(priceData.exactLength) || 0;
                            const rollWidthFt = exactWidth > 0 ? exactWidth / 12 : 0;
                            const sqftPerTileVal = (exactWidth > 0 && exactLength > 0) ? (exactWidth/12)*(exactLength/12) : 0;
                            const divisorSqft = (calcType === 'roll' && cov === 0 && rollWidthFt > 0) ? rollWidthFt : cov;
                            var displayFinalPrice = priceData.finalPrice.amount;
                            var displayOldPrice = priceData.oldPrice ? priceData.oldPrice.amount : displayFinalPrice;
                            var displayBasePrice = priceData.basePrice ? priceData.basePrice.amount : displayFinalPrice;
                            if (divisorSqft > 0 && ['case','roll','sqft'].includes(calcType)) {
                                displayFinalPrice = priceData.finalPrice.amount / divisorSqft;
                                displayOldPrice = priceData.oldPrice ? priceData.oldPrice.amount / divisorSqft : displayFinalPrice;
                                displayBasePrice = priceData.basePrice ? priceData.basePrice.amount / divisorSqft : displayFinalPrice;
                            } else if (sqftPerTileVal > 0 && calcType === 'sqft') {
                                displayFinalPrice = priceData.finalPrice.amount / sqftPerTileVal;
                                displayOldPrice = priceData.oldPrice ? priceData.oldPrice.amount / sqftPerTileVal : displayFinalPrice;
                                displayBasePrice = priceData.basePrice ? priceData.basePrice.amount / sqftPerTileVal : displayFinalPrice;
                            }
                            const regularPriceLabel = root.querySelector('.normal-price .price-label') || root.querySelector('.price-label');
                            const regularPriceElement = root.querySelector('.normal-price [data-price-type=finalPrice].price-wrapper .price')
                                || root.querySelector('.price-container [data-price-type=finalPrice].price-wrapper .price')
                                || root.querySelector('[data-price-type=finalPrice].price-wrapper .price')
                                || root.querySelector('.price-wrapper .price');
                            const basePriceElement = root.querySelector('[data-price-type=basePrice].price-wrapper .price');
                            if (regularPriceLabel) {
                                if (priceData.oldPrice && priceData.finalPrice.amount < priceData.oldPrice.amount) {
                                    regularPriceLabel.classList.add('hidden');
                                } else {
                                    regularPriceLabel.classList.remove('hidden');
                                }
                            }
                            if (regularPriceElement) regularPriceElement.innerText = hyva.formatPrice(displayFinalPrice);
                            if (basePriceElement && priceData.basePrice) basePriceElement.innerText = hyva.formatPrice(displayBasePrice);
                            const priceMrpNew = root.querySelector('.price-mrp-new');
                            const savePriceEl = root.querySelector('.price-mrp .savePrice');
                            if (priceMrpNew && priceData.oldPrice && priceData.finalPrice.amount < priceData.oldPrice.amount) {
                                priceMrpNew.innerHTML = 'was ' + hyva.formatPrice(displayOldPrice);
                                const priceMrp = root.querySelector('.price-mrp');
                                if (priceMrp) priceMrp.style.display = '';
                                if (savePriceEl) {
                                    const saveAmt = displayOldPrice - displayFinalPrice;
                                    const pct = Math.round(saveAmt * 100 / displayOldPrice);
                                    savePriceEl.textContent = 'Save ' + pct + '%';
                                }
                            } else if (priceMrpNew && (!priceData.oldPrice || priceData.finalPrice.amount >= priceData.oldPrice.amount)) {
                                const priceMrp = root.querySelector('.price-mrp');
                                if (priceMrp) priceMrp.style.display = 'none';
                            }
                            if (priceData.getIncstoresPimCoverage !== undefined || priceData.calculatorType !== undefined) {
                                const cov = parseFloat(priceData.getIncstoresPimCoverage) || 0;
                                const calcType = (priceData.calculatorType || '').toLowerCase();
                                const exactWidth = parseFloat(priceData.exactWidth) || 0;
                                const exactLength = parseFloat(priceData.exactLength) || 0;
                                const sqftPerTileVal = (exactWidth > 0 && exactLength > 0) ? (exactWidth/12)*(exactLength/12) : this.sqftPerTile;
                                const rollWidthFt = exactWidth > 0 ? exactWidth / 12 : 0;
                                if (calcType === 'none') {
                                    this.secondaryPriceFormatted = '';
                                    this.secondaryPriceOldFormatted = '';
                                    this.secondaryPriceLabel = '';
                                } else if (calcType === 'roll' && (rollWidthFt > 0 || cov > 0)) {
                                    this.coveragePerCase = cov > 0 ? cov : rollWidthFt;
                                    this.sqftPerTile = 0;
                                    this.secondaryPriceFormatted = hyva.formatPrice(priceData.finalPrice.amount);
                                    this.secondaryPriceOldFormatted = (priceData.oldPrice && priceData.oldPrice.amount > priceData.finalPrice.amount) ? hyva.formatPrice(priceData.oldPrice.amount) : '';
                                    this.secondaryPriceLabel = '/linear foot';
                                } else if (cov > 0 && ['case','sqft'].includes(calcType)) {
                                    this.coveragePerCase = cov;
                                    this.sqftPerTile = 0;
                                    this.secondaryPriceFormatted = hyva.formatPrice(priceData.finalPrice.amount);
                                    this.secondaryPriceOldFormatted = (priceData.oldPrice && priceData.oldPrice.amount > priceData.finalPrice.amount) ? hyva.formatPrice(priceData.oldPrice.amount) : '';
                                    this.secondaryPriceLabel = '/case';
                                } else if (sqftPerTileVal > 0 && calcType === 'sqft') {
                                    this.sqftPerTile = sqftPerTileVal;
                                    this.coveragePerCase = 0;
                                    this.secondaryPriceFormatted = hyva.formatPrice(priceData.finalPrice.amount);
                                    this.secondaryPriceOldFormatted = (priceData.oldPrice && priceData.oldPrice.amount > priceData.finalPrice.amount) ? hyva.formatPrice(priceData.oldPrice.amount) : '';
                                    this.secondaryPriceLabel = '/tile';
                                }
                            }
                        }
                    };
                }
                function selectSwatchRelated(selectEl, productId, produrl, attributeId) {
                    var container = selectEl.closest('.configurable-options-related');
                    var baseUrl = produrl;
                    var params = [];
                    if (container) {
                        container.querySelectorAll('.super-attribute-select, input.super-attribute-fixed').forEach(function(el) {
                            var attrId = el.dataset.attrId || el.getAttribute('data-attr-id');
                            var val = el.tagName === 'SELECT' ? el.value : (el.value || '');
                            if (attrId && val) params.push('super_attribute[' + attrId + ']=' + encodeURIComponent(val));
                        });
                        if (params.length) baseUrl = produrl + (produrl.indexOf('?') >= 0 ? '&' : '?') + params.join('&');
                    }
