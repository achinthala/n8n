}

$calculatorType = $product->getAttributeText('incstores_pim_calculator_type');
$childCalculatorMap = [];
$childSaleableMap = [];
$hasAddToCartChild = false;

if ($product->getTypeId() === 'configurable') {
    $usedProducts = $product->getTypeInstance()->getUsedProducts($product);
    foreach ($usedProducts as $child) {
        if ($child->getStatus() != \Magento\Catalog\Model\Product\Attribute\Source\Status::STATUS_ENABLED) {
            continue;
        }
        $childCalcType = $child->getAttributeText('incstores_pim_calculator_type');
        if (in_array(strtolower((string)$childCalcType), ['none', 'case', 'roll', 'sqft', 'pre_cut_roll'], true)) {
            $hasAddToCartChild = true;
        }
        $keyParts = [];
        foreach ($productAttributeOptions as $configAttr) {
            $attrCode = $configAttr['attribute_code'] ?? '';
            $attrId = (int)($configAttr['attribute_id'] ?? $configAttr['id'] ?? 0);
            if ($attrCode && $attrId) {
                $val = $child->getData($attrCode);
                if ($val !== null && $val !== '') {
                    $keyParts[] = $attrId . '_' . $val;
                }
            }
        }
        sort($keyParts);
        $mapKey = implode('|', $keyParts);
        if ($mapKey) {
            $childCalculatorMap[$mapKey] = strtolower((string)$childCalcType);
        }
    }
    $childSaleableMap = $customViewModel->getChildSaleableMap($product, $productAttributeOptions);
    $showAddToCartInPopup = $hasAddToCartChild;
    $hasNonAddableChild = false;
    foreach ($childCalculatorMap as $ct) {
        if (!in_array($ct, ['none', 'case', 'roll', 'sqft', 'pre_cut_roll'], true)) {
            $hasNonAddableChild = true;
            break;
        }
    }
    $isConfigurableWithMixedChildren = $hasAddToCartChild && $hasNonAddableChild;
} else {
    $showAddToCartInPopup = in_array(strtolower((string)$calculatorType), ['none', 'case', 'sqft', 'pre_cut_roll'], true);
    $isConfigurableWithMixedChildren = false;
}

// Compute secondary price (per case or per tile) - use finalPrice from product/option config
$secondaryPriceFormatted = '';
$secondaryPriceOldFormatted = '';
$secondaryPriceLabel = '';
$showSecondaryPrice = false;
$coveragePerCase = 0;
$sqftPerTile = 0;

if ($product->getTypeId() === 'configurable') {
    $usedProducts = $product->getTypeInstance()->getUsedProducts($product);
    $minPriceChild = null;
    $minPrice = PHP_FLOAT_MAX;
    foreach ($usedProducts as $child) {
        if ($child->getStatus() != \Magento\Catalog\Model\Product\Attribute\Source\Status::STATUS_ENABLED) {
            continue;
        }
        $fp = (float)$child->getFinalPrice(1);
        if ($fp < $minPrice && $fp > 0) {
            $minPrice = $fp;
            $minPriceChild = $child;
        }
    }
    $priceProduct = $minPriceChild ?? $product;
} else {
    $priceProduct = $product;
}

$calcTypeForSecondary = strtolower((string)($priceProduct->getAttributeText('incstores_pim_calculator_type') ?? ''));
$finalPrice = (float)$priceProduct->getFinalPrice(1);
$regularPrice = (float)$priceProduct->getPrice();
$coveragePerCase = (float)($priceProduct->getIncstoresPimCoverage() ?: 0);
$exactWidth = (float)($priceProduct->getData('incstores_pim_exact_width_inches') ?: 0);
$exactLength = (float)($priceProduct->getData('incstores_pim_exact_length_inches') ?: 0);
if ($calcTypeForSecondary === 'roll' && $exactWidth === 0.0 && method_exists($priceProduct, 'getRollWidth')) {
    $exactWidth = (float)$priceProduct->getRollWidth();
}
if ($exactWidth > 0 && $exactLength > 0) {
    $sqftPerTile = round(($exactWidth / 12) * ($exactLength / 12), 2);
}

if ($finalPrice > 0) {
    if ($calcTypeForSecondary === 'roll' && $exactWidth > 0) {
        $rollWidthFt = ceil($exactWidth / 12);
        $pricePerLinearFoot = $rollWidthFt > 0 ? $rollWidthFt * $finalPrice : $finalPrice;
        $secondaryPriceFormatted = strip_tags($productViewModel->format($pricePerLinearFoot));
        if ($regularPrice > $finalPrice && $regularPrice > 0) {
            $oldPricePerLinearFoot = $rollWidthFt > 0 ? $rollWidthFt * $regularPrice : $regularPrice;
            $secondaryPriceOldFormatted = strip_tags($productViewModel->format($oldPricePerLinearFoot));
        }
        $secondaryPriceLabel = '/linear foot';
        $showSecondaryPrice = true;
    } elseif (in_array($calcTypeForSecondary, ['case', 'sqft'], true) && $coveragePerCase > 0) {
        $secondaryPriceFormatted = strip_tags($productViewModel->format($finalPrice));
        if ($regularPrice > $finalPrice && $regularPrice > 0) {
            $secondaryPriceOldFormatted = strip_tags($productViewModel->format($regularPrice));
        }
        $secondaryPriceLabel = '/case';
        $showSecondaryPrice = true;
    } elseif ($calcTypeForSecondary === 'sqft' && $priceProduct->getData('incstores_pim_has_corner_border_center') == 0
        && $sqftPerTile > 0) {
        $secondaryPriceFormatted = strip_tags($productViewModel->format($finalPrice));
        if ($regularPrice > $finalPrice && $regularPrice > 0) {
            $secondaryPriceOldFormatted = strip_tags($productViewModel->format($regularPrice));
        }
        $secondaryPriceLabel = '/tile';
        $showSecondaryPrice = true;
    }
}
