<?php $_shipment = $block->getShipment() ?>
<?php $_order    = $block->getOrder() ?>
<?php if ($_shipment && $_order) : ?>
    <table class="email-items" border="0" width="100%" cellpadding="0" cellspacing="0" align="center" bgcolor="#DCE5EC">
        <thead>
            <tr>
                <th width="30">&nbsp;</th>
