<?xml version="1.0"?>
<!-- Admin configuration for Email Guard -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="emailrestrict" sortOrder="1900" showInDefault="1" showInWebsite="1" showInStore="0">
            <label>Email Restriction</label>
            <tab>general</tab>
            <resource>Dcw_EmailRestrict::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Settings</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1">
                    <label>Enable Email Guard</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="allowed_domains" translate="label" type="textarea" sortOrder="20" showInDefault="1" showInWebsite="1">
                    <label>Allowed Domains (comma or newline separated)</label>
                    <comment>Examples: example.com, gmail.com, *.company.com</comment>
                </field>
            </group>
        </section>
    </system>
</config>