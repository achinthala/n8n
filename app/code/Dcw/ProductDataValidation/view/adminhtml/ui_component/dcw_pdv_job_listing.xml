<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">dcw_pdv_job_listing.dcw_pdv_job_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>dcw_pdv_job_columns</spinner>
        <deps>
            <dep>dcw_pdv_job_listing.dcw_pdv_job_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="dcw_pdv_job_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">job_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Dcw_ProductDataValidation::view</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="dcw_pdv_job_listing_data_source">
            <settings>
                <requestFieldName>job_id</requestFieldName>
                <primaryFieldName>job_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="dcw_pdv_job_columns">
        <column name="job_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Job ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="status" component="Magento_Ui/js/grid/columns/select" sortOrder="20">
            <settings>
                <filter>select</filter>
                <options class="Dcw\ProductDataValidation\Model\Config\Source\JobStatusOptions"/>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="total_eligible" sortOrder="30">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Eligible</label>
            </settings>
        </column>
        <column name="products_checked" sortOrder="40">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Checked</label>
            </settings>
        </column>
        <column name="products_with_issues" sortOrder="50">
            <settings>
                <filter>textRange</filter>
                <label translate="true">With Issues</label>
            </settings>
        </column>
        <column name="products_passed" sortOrder="60">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Passed</label>
            </settings>
        </column>
        <column name="execution_time" sortOrder="70">
            <settings>
                <filter>false</filter>
                <label translate="true">Execution Time (s)</label>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="80">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Created</label>
            </settings>
        </column>
        <column name="started_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="90">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Started</label>
            </settings>
        </column>
        <column name="completed_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="100">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Completed</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Dcw\ProductDataValidation\Ui\Component\Listing\Column\JobActions" sortOrder="200">
            <settings>
                <indexField>job_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
