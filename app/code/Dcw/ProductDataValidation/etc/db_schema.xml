<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="dcw_product_data_validation_job"
           resource="default"
           engine="innodb"
           comment="Product Data Validation Jobs">
        <column xsi:type="int" name="job_id" unsigned="true" nullable="false" identity="true"
                comment="Job ID"/>
        <column xsi:type="varchar" name="status" nullable="false" length="32" default="pending"
                comment="Job Status"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="started_at" on_update="false" nullable="true"
                comment="Started At"/>
        <column xsi:type="timestamp" name="completed_at" on_update="false" nullable="true"
                comment="Completed At"/>
        <column xsi:type="int" name="total_eligible" unsigned="true" nullable="false" default="0"
                comment="Total Eligible Products"/>
        <column xsi:type="int" name="products_checked" unsigned="true" nullable="false" default="0"
                comment="Products Checked"/>
        <column xsi:type="int" name="products_with_issues" unsigned="true" nullable="false" default="0"
                comment="Products With Issues"/>
        <column xsi:type="int" name="products_passed" unsigned="true" nullable="false" default="0"
                comment="Products Passed"/>
        <column xsi:type="decimal" name="execution_time" scale="3" precision="12" unsigned="true"
                nullable="true" comment="Execution Time Seconds"/>
        <column xsi:type="int" name="created_by" unsigned="true" nullable="true"
                comment="Admin User ID"/>
        <column xsi:type="text" name="error_message" nullable="true" comment="Error Message"/>
        <column xsi:type="mediumtext" name="attribute_breakdown" nullable="true"
                comment="Missing Attribute Counts JSON"/>
        <column xsi:type="text" name="store_ids" nullable="true"
                comment="Validated Store IDs CSV"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="job_id"/>
        </constraint>
        <index referenceId="DCW_PDV_JOB_STATUS" indexType="btree">
            <column name="status"/>
        </index>
        <index referenceId="DCW_PDV_JOB_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
    </table>

    <table name="dcw_product_data_validation_result"
           resource="default"
           engine="innodb"
           comment="Product Data Validation Results">
        <column xsi:type="int" name="result_id" unsigned="true" nullable="false" identity="true"
                comment="Result ID"/>
        <column xsi:type="int" name="job_id" unsigned="true" nullable="false" comment="Job ID"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="false"
                comment="Product ID"/>
        <column xsi:type="varchar" name="sku" nullable="false" length="64" comment="SKU"/>
        <column xsi:type="varchar" name="product_name" nullable="true" length="255"
                comment="Product Name"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" default="0"
                comment="Store ID"/>
        <column xsi:type="text" name="missing_attributes" nullable="false"
                comment="Missing Attribute Codes CSV"/>
        <column xsi:type="varchar" name="status" nullable="false" length="32" default="missing"
                comment="Result Status"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="result_id"/>
        </constraint>
        <constraint xsi:type="foreign"
                    referenceId="DCW_PDV_RESULT_JOB_ID_DCW_PDV_JOB_JOB_ID"
                    table="dcw_product_data_validation_result"
                    column="job_id"
                    referenceTable="dcw_product_data_validation_job"
                    referenceColumn="job_id"
                    onDelete="CASCADE"/>
        <index referenceId="DCW_PDV_RESULT_JOB_ID" indexType="btree">
            <column name="job_id"/>
        </index>
        <index referenceId="DCW_PDV_RESULT_SKU" indexType="btree">
            <column name="sku"/>
        </index>
        <index referenceId="DCW_PDV_RESULT_STORE_ID" indexType="btree">
            <column name="store_id"/>
        </index>
        <index referenceId="DCW_PDV_RESULT_PRODUCT_ID" indexType="btree">
            <column name="product_id"/>
        </index>
        <index referenceId="DCW_PDV_RESULT_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
    </table>
</schema>
