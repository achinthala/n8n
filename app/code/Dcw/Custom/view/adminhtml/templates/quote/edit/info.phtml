<?= /* @noEscape */ $secureRenderer->renderTag(
    'script',
    ['type' => 'text/javascript'],
    'require([
        \'jquery\',
        \'jquery/ui\', // can\'t be removed, but can be replaced with: \'jquery-ui-modules/datepicker\'
        \'mage/calendar\'
    ], function ($) {
    var editDates = $(\'.edit-date\');
    editDates.calendar({
            showOn: \'both\',
            changeYear: true,
            yearRange: \'1900:2100\',
            autoSize: true,
            buttonText: \'\',
            minDate: new Date(),
            dateFormat: "' . $escaper->escapeHtml($block->getDateFormat()) . '"
        });
        $.each(editDates, function (key, editDate) {
            var dateValue = $(editDate).val();
            if (dateValue) {
                // Extract just the date portion (before comma if time is included)
                var dateOnly = dateValue.split(\',\')[0].trim();
                if (dateOnly && !isNaN(Date.parse(dateOnly))) {
                    try {
                        $(editDate).datepicker(\'setDate\', dateOnly);
                    } catch (e) {
                        // If setDate fails, try parsing with Date object
                        var parsedDate = new Date(dateValue);
                        if (!isNaN(parsedDate.getTime())) {
                            $(editDate).datepicker(\'setDate\', parsedDate);
                        }
                    }
                }
            }
        });
    });',
    false
) ?>
