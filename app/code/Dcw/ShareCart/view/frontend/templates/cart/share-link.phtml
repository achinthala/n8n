                                  placeholder="<?= $escaper->escapeHtmlAttr(__('Add Custom Message...')) ?>"></textarea>
                    </div>

                    <div class="flex gap-6 pt-2 btn-container">
                        <button type="submit" class="btn btn-primary flex-1 send" :disabled="isSubmitting">
                            <span x-show="!isSubmitting"><?= $escaper->escapeHtml(__('Send')) ?></span>
                            <span x-show="isSubmitting"><?= $escaper->escapeHtml(__('Sending...')) ?></span>
                        </button>
                        <button type="button" class="btn btn-secondary flex-1 cancel" @click="closeModal()" :disabled="isSubmitting">
                            <?= $escaper->escapeHtml(__('Cancel')) ?>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </template>
</div>
