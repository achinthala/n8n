<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="dcw_share_cart" resource="default" engine="innodb" comment="Share Cart History and Audit">
        <column xsi:type="int" name="share_id" unsigned="true" nullable="false" identity="true" comment="Share ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" comment="Store ID"/>
        <column xsi:type="int" name="quote_id" unsigned="true" nullable="true" comment="Source Quote ID"/>
        <column xsi:type="varchar" name="token" nullable="false" length="64" comment="Share Token"/>
        <column xsi:type="varchar" name="shared_by_type" nullable="false" length="32" default="customer" comment="Shared By Type"/>
        <column xsi:type="int" name="shared_by_customer_id" unsigned="true" nullable="true" comment="Shared By Customer ID"/>
        <column xsi:type="int" name="shared_by_admin_user_id" unsigned="true" nullable="true" comment="Shared By Admin User ID"/>
        <column xsi:type="varchar" name="shared_by_email" nullable="true" length="255" comment="Shared By Email"/>
        <column xsi:type="varchar" name="your_name" nullable="true" length="255" comment="Your Name"/>
        <column xsi:type="varchar" name="shared_by_name" nullable="true" length="255" comment="Sender Name (legacy)"/>
        <column xsi:type="varchar" name="sender_phone" nullable="true" length="64" comment="Sender Phone (legacy)"/>
        <column xsi:type="varchar" name="recipient_name" nullable="true" length="255" comment="Recipient Name"/>
        <column xsi:type="varchar" name="recipient_email" nullable="false" length="255" comment="Recipient Email"/>
        <column xsi:type="varchar" name="recipient_first_name" nullable="true" length="128" comment="Recipient First Name (legacy)"/>
        <column xsi:type="varchar" name="recipient_last_name" nullable="true" length="128" comment="Recipient Last Name (legacy)"/>
        <column xsi:type="varchar" name="recipient_phone" nullable="true" length="64" comment="Recipient Phone"/>
        <column xsi:type="smallint" name="sms_consent" unsigned="true" nullable="false" default="0" comment="Sender SMS Consent"/>
        <column xsi:type="text" name="custom_message" nullable="true" comment="Custom Message"/>
        <column xsi:type="mediumtext" name="cart_snapshot" nullable="false" comment="Cart Snapshot JSON"/>
        <column xsi:type="varchar" name="link_status" nullable="false" length="32" default="active" comment="Link Status"/>
        <column xsi:type="timestamp" name="expires_at" on_update="false" nullable="false" comment="Expires At"/>
        <column xsi:type="timestamp" name="used_at" on_update="false" nullable="true" comment="Used At"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="share_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="DCW_SHARE_CART_TOKEN">
            <column name="token"/>
        </constraint>
        <index referenceId="DCW_SHARE_CART_RECIPIENT_EMAIL" indexType="btree">
            <column name="recipient_email"/>
        </index>
        <index referenceId="DCW_SHARE_CART_SHARED_BY_CUSTOMER" indexType="btree">
            <column name="shared_by_customer_id"/>
        </index>
        <index referenceId="DCW_SHARE_CART_LINK_STATUS" indexType="btree">
            <column name="link_status"/>
        </index>
        <index referenceId="DCW_SHARE_CART_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
    </table>
</schema>
