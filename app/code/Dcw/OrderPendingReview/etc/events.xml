<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_model_service_quote_submit_failure">
        <observer name="dcw_order_pending_review_quote_submit_failure_increment"
                  instance="Dcw\OrderPendingReview\Observer\QuoteSubmitFailureIncrementFailedAttempts"/>
    </event>
    <event name="sales_order_place_after">
        <observer name="dcw_order_pending_review_apply_place_after"
                  instance="Dcw\OrderPendingReview\Observer\ApplyPendingReviewAfterPlaceOrder"/>
    </event>
    <event name="salesrule_rule_condition_combine">
        <observer name="dcw_order_pending_review_salesrule_combine_conditions"
                  instance="Dcw\OrderPendingReview\Observer\AddSalesRuleCombineConditions"/>
    </event>
</config>
