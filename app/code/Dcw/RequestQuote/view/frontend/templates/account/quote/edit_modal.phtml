</div>

<script>
    function dcwQuoteEditModal() {
        return {
            showPopup: false,
            hrefLink: '',
            init() {
                window.addEventListener('dcw-quote-edit-open-modal', (e) => {
                    this.show();
                    this.hrefLink = e.detail;
                });
            },
            hide() {
                this.showPopup = false;
            },
            show() {
                this.showPopup = true;
                hyva.trapFocus(this.$el);
                window.setTimeout(() => {
                    this.$el.querySelector('[x-focus-first]').focus();
                }, 200);
            },
            async confirm() {
                this.hide();
                window.dispatchEvent(new CustomEvent('amcart-loading-start'));
                try {
                    // Add isAjax parameter to ensure request is detected as AJAX
                    let url = this.hrefLink;
                    if (url.indexOf('?') === -1) {
                        url += '?isAjax=1';
                    } else {
                        url += '&isAjax=1';
                    }
                    
                    let response = await fetch(url, {
                        method: 'POST',
                        headers: {
                            'content-type': 'application/x-www-form-urlencoded; charset=UTF-8',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: new URLSearchParams({
                            form_key: hyva.getFormKey()
                        })
                    });
                    
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    
                    let result = await response.json();
                    window.dispatchEvent(new CustomEvent('amcart-loading-stop'));

                    if (result.redirectUrl) {
                        // Redirect to quote cart page
                        window.location.href = result.redirectUrl;
                    } else {
                        // Fallback: redirect to quote cart if redirectUrl not provided
                        window.location.href = BASE_URL + 'amasty_quote/cart/';
                    }
                } catch (error) {
                    window.dispatchEvent(new CustomEvent('amcart-loading-stop'));
                    window.location.reload();
                }
            }
        }
    }

    window.addEventListener(
        'alpine:init',
        () => Alpine.data('dcwQuoteEditModal', dcwQuoteEditModal),
        {once: true}
    );
</script>
