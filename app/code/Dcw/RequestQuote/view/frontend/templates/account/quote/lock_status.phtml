<?php
/**
 * Quote Lock Status Template (Frontend)
 * @var \Dcw\RequestQuote\Block\Account\Quote\LockStatus $block
 * @var \Magento\Framework\Escaper $escaper
 */

$lockStatus = $block->getLockStatus();
$quoteId = $block->getQuoteId();
$isLockedByAdmin = $lockStatus && $lockStatus['is_locked'] && isset($lockStatus['locked_by_type']) && $lockStatus['locked_by_type'] === 'admin';
?>
<?php if ($quoteId): ?>
<div id="quote-lock-status" 
     data-quote-id="<?= $escaper->escapeHtmlAttr($quoteId) ?>"
     data-status-url="<?= $escaper->escapeUrl($block->getLockStatusUrl()) ?>">
    <?php if ($isLockedByAdmin): ?>
    <div class="message message-warning warning" id="quote-lock-warning" style="margin-bottom: 20px;">
        <div data-ui-id="messages-message-warning">
            <span id="quote-lock-message">
                <?= $escaper->escapeHtml(__('This cart is currently being edited by %1.', $lockStatus['locked_by_name'] ?? 'Admin')) ?>
            </span>
        </div>
    </div>
    <?php else: ?>
    <div class="message message-warning warning" id="quote-lock-warning" style="display: none; margin-bottom: 20px;">
        <div data-ui-id="messages-message-warning">
            <span id="quote-lock-message"></span>
        </div>
    </div>
    <?php endif; ?>
</div>

<script>
(function() {
    'use strict';
    
    var quoteId = <?= (int) $quoteId ?>;
    var statusUrl = '<?= $escaper->escapeJs($block->getLockStatusUrl()) ?>';
    var formKey = typeof hyva !== 'undefined' ? hyva.getFormKey() : '';
    var isLockedByAdmin = <?= $isLockedByAdmin ? 'true' : 'false' ?>;
    
    function getElement(selector) {
        return document.querySelector(selector);
    }
    
    function getAllElements(selector) {
        return document.querySelectorAll(selector);
    }
    
    function checkLockStatus() {
        if (!statusUrl || !quoteId) {
            return;
        }
        
        var url = statusUrl + '?quote_id=' + quoteId;
        if (formKey) {
            url += '&form_key=' + formKey;
        }
        
        fetch(url, {
            method: 'GET',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            },
            credentials: 'include'
        })
        .then(function(response) {
            return response.json();
        })
        .then(function(data) {
            if (data.success && data.lock_status) {
                if (data.lock_status.is_locked && data.lock_status.locked_by_type === 'admin') {
                    showLockWarning(data.lock_status);
                } else {
                    hideLockWarning();
                }
            }
        })
        .catch(function() {
            // Silent fail
        });
    }
    
    function showLockWarning(lockStatus) {
        var warning = getElement('#quote-lock-warning');
        var message = getElement('#quote-lock-message');
        
        if (warning && message) {
            var adminName = lockStatus.locked_by_name || 'Admin';
            message.textContent = 'This cart is currently being edited by ' + adminName + '.';
            warning.style.display = 'block';
            disableActionButtons();
        }
    }
    
    function hideLockWarning() {
        var warning = getElement('#quote-lock-warning');
        if (warning) {
            warning.style.display = 'none';
        }
        enableActionButtons();
    }
    
    function disableActionButtons() {
        // Disable Edit button in history page
        var editButtons = getAllElements('button[data-dcwquote-edit-url], .action.quote.edit');
        editButtons.forEach(function(btn) {
            btn.disabled = true;
            btn.style.opacity = '0.5';
            btn.style.pointerEvents = 'none';
            btn.style.cursor = 'not-allowed';
            
            // Prevent click
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                return false;
            }, true);
        });
        
        // Disable Edit button via Alpine.js (dcwEditQuoteButton)
        var editButtonsAlpine = getAllElements('[x-data*="dcwEditQuoteButton"] button, [data-dcwquote-edit-url]');
        editButtonsAlpine.forEach(function(btn) {
            btn.disabled = true;
            btn.style.opacity = '0.5';
            btn.style.pointerEvents = 'none';
            btn.style.cursor = 'not-allowed';
            btn.setAttribute('data-lock-disabled', 'true');
            
            // Override Alpine.js click handler
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopImmediatePropagation();
                return false;
            }, true);
        });
        
        // Disable "Get New Quote" button
        var newQuoteButtons = getAllElements('a[href*="createNewFromExpired"]');
        newQuoteButtons.forEach(function(btn) {
            btn.style.pointerEvents = 'none';
            btn.style.opacity = '0.5';
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                return false;
            }, true);
        });
    }
    
    function enableActionButtons() {
        // Enable Edit buttons
        var editButtons = getAllElements('button[data-dcwquote-edit-url], .action.quote.edit, [x-data*="dcwEditQuoteButton"] button');
        editButtons.forEach(function(btn) {
            btn.disabled = false;
            btn.style.opacity = '';
            btn.style.pointerEvents = '';
            btn.style.cursor = '';
            btn.removeAttribute('data-lock-disabled');
        });
        
        // Enable "Get New Quote" button
        var newQuoteButtons = getAllElements('a[href*="createNewFromExpired"]');
        newQuoteButtons.forEach(function(btn) {
            btn.style.pointerEvents = '';
            btn.style.opacity = '';
        });
    }
    
    // Initialize
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
            if (isLockedByAdmin) {
                disableActionButtons();
            }
            checkLockStatus();
        });
    } else {
        if (isLockedByAdmin) {
            disableActionButtons();
        }
        checkLockStatus();
    }
})();
</script>
<?php endif; ?>
<?php isset($hyvaCsp) && $hyvaCsp->registerInlineScript() ?>
