<?php endif; ?>

<script>
require(['jquery', 'mage/translate'], function($, $t) {
    window.canApplyFullDiscount = <?= $canApplyFullDiscount ? 'true' : 'false' ?>;
    var quoteId = <?= $quoteId ? (int)$quoteId : 'null' ?>;
    var logDiscountUrl = '<?= $escaper->escapeJs($logDiscountUrl) ?>';
    var lockStatusUrl = '<?= $escaper->escapeJs($lockStatusUrl) ?>';
    var isLockedByCustomer = <?= $isLockedByCustomer ? 'true' : 'false' ?>;
    var canControlPricing = <?= $canControlPricing ? 'true' : 'false' ?>;
    var isDisabled = isLockedByCustomer || !canControlPricing;
    
    /**
     * Check if quote is locked by customer (synchronous check)
     * @param {Function} callback - Function to call if not locked (or if error)
     * @param {Function} errorCallback - Function to call if locked by customer
     */
    function checkLockStatus(callback, errorCallback) {
        if (!quoteId || !lockStatusUrl) {
            // If no quote ID or status URL, proceed anyway
            if (callback) callback();
            return;
        }
        
        // Use synchronous AJAX to block execution until check completes
        var isLocked = false;
        var lockStatus = null;
        
        $.ajax({
            url: lockStatusUrl,
            type: 'GET',
            dataType: 'json',
            async: false, // Make it synchronous to block execution
            data: {
                quote_id: quoteId
            },
            success: function(response) {
                if (response.success && response.lock_status) {
                    lockStatus = response.lock_status;
                    // Check if locked by customer
                    if (lockStatus.is_locked && lockStatus.locked_by_type === 'customer') {
                        isLocked = true;
                    }
                }
            },
            error: function() {
                // On error, proceed anyway (don't block if status check fails)
                isLocked = false;
            }
        });
        
        if (isLocked && lockStatus) {
            var customerName = lockStatus.locked_by_name || 'Customer';
            var message = $t('This quote is currently being edited by customer %1. Please wait until they finish editing or use "Force Unlock" to override.').replace('%1', customerName);
            alert(message);
            if (errorCallback) errorCallback();
            return false;
        }
        
        // Not locked by customer, proceed
        if (callback) callback();
        return true;
    }
    
    window.validateDiscountBeforeUpdate = function() {
        // Check if disabled (locked by customer or no permission)
        if (isDisabled) {
            if (isLockedByCustomer) {
                alert($t('This quote is currently being edited by a customer. Please wait until they finish editing.'));
            } else if (!canControlPricing) {
                alert($t('You do not have permission to update items and quantities.'));
            }
            return false;
        }
        
        // Check lock status before proceeding - if locked, return early
        var canProceed = checkLockStatus(
            function() {
                // Not locked by customer, proceed with update
                var discountInput = $('#discount');
                var discountValue = parseFloat(discountInput.val()) || 0;
                var oldDiscount = parseFloat(discountInput.data('old-discount')) || 0;
                
                if (discountValue >= 100) {
                    if (!window.canApplyFullDiscount) {
                        alert($t('You do not have permission to apply 100% discounts.'));
                        return false;
                    }
                }
                
                if (quoteId && Math.abs(discountValue - oldDiscount) > 0.0001) {
                    $.ajax({
                        url: logDiscountUrl,
                        type: 'POST',
                        dataType: 'json',
                        data: {
                            quote_id: quoteId,
                            old_discount: oldDiscount,
                            new_discount: discountValue,
                            form_key: FORM_KEY
                        }
                    });
                }
                
                function executeItemsUpdate() {
                    if (typeof window.quote !== 'undefined' && typeof window.quote.itemsUpdate === 'function') {
                        window.quote.itemsUpdate();
                        return true;
                    }
                    return false;
                }
                
                if (!executeItemsUpdate()) {
                    var retryCount = 0;
                    var maxRetries = 10;
                    var retryInterval = setInterval(function() {
                        retryCount++;
                        if (executeItemsUpdate()) {
                            clearInterval(retryInterval);
                        } else if (retryCount >= maxRetries) {
                            clearInterval(retryInterval);
                            alert($t('Unable to update items. Please refresh the page and try again.'));
                        }
                    }, 100);
                }
            },
            function() {
                // Locked by customer, do nothing (alert already shown)
            }
        );
        
        // If checkLockStatus returned false, we're locked - don't proceed
        if (canProceed === false) {
            return false;
        }
        
        return true;
    };
    
    window.removeModificatorsWithLogging = function() {
        // Check if disabled (locked by customer or no permission)
        if (isDisabled) {
            if (isLockedByCustomer) {
                alert($t('This quote is currently being edited by a customer. Please wait until they finish editing.'));
            } else if (!canControlPricing) {
                alert($t('You do not have permission to remove discounts.'));
            }
            return false;
        }
        
        // Check lock status before proceeding - if locked, return early
        var canProceed = checkLockStatus(
            function() {
                // Not locked by customer, proceed with removal
                var discountInput = $('#discount');
                var currentDiscount = parseFloat(discountInput.val()) || 0;
                
                if (quoteId && currentDiscount > 0) {
                    $.ajax({
                        url: logDiscountUrl,
                        type: 'POST',
                        dataType: 'json',
                        data: {
                            quote_id: quoteId,
                            old_discount: currentDiscount,
                            new_discount: 0,
                            form_key: FORM_KEY
                        }
                    });
                }
                
                if (typeof window.quote !== 'undefined' && typeof window.quote.removeModificators === 'function') {
                    window.quote.removeModificators();
                } else if (typeof quote !== 'undefined' && typeof quote.removeModificators === 'function') {
                    quote.removeModificators();
                }
            },
            function() {
                // Locked by customer, do nothing (alert already shown)
            }
        );
        
        // If checkLockStatus returned false, we're locked - don't proceed
        if (canProceed === false) {
            return false;
        }
    };
    
    // Ensure buttons are disabled on page load if permission is missing or quote is locked
    $(document).ready(function() {
        if (isDisabled) {
            $('#update-items-quantities-btn-top, #update-items-quantities-btn, #remove-discount-btn').prop('disabled', true);
        }
    });
});
</script>
