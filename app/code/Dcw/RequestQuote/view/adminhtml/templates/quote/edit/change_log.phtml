<?php
/**
 * Admin Quote Change Log Template
 */

use Magento\Framework\Escaper;

/** @var \Dcw\RequestQuote\Block\Adminhtml\Quote\Edit\ChangeLog $block */
/** @var Escaper $escaper */

$changeLogs = $block->getChangeLogs();
?>

<?php if (!empty($changeLogs)): ?>
    <div class="admin__page-section quote-change-log">
        <div class="admin__page-section-title">
            <span class="title"><?= $escaper->escapeHtml(__('Quote Change History')) ?></span>
        </div>
        <div class="admin__page-section-content">
            <div class="admin__table-wrapper">
                <table class="data-table admin__table-primary quote-change-log-table">
                    <thead>
                        <tr class="headings">
                            <th class="col-date"><span><?= $escaper->escapeHtml(__('Date')) ?></span></th>
                            <th class="col-action"><span><?= $escaper->escapeHtml(__('Action')) ?></span></th>
                            <th class="col-details"><span><?= $escaper->escapeHtml(__('Details')) ?></span></th>
                            <th class="col-changed-by"><span><?= $escaper->escapeHtml(__('Changed By')) ?></span></th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php foreach ($changeLogs as $log): ?>
                            <?php $logData = $block->formatLogData($log); ?>
                            <tr>
                                <td class="col-date">
                                    <?= $escaper->escapeHtml($block->formatDate($logData['created_at'], \IntlDateFormatter::MEDIUM, true)) ?>
                                </td>
                                <td class="col-action">
                                    <?= $escaper->escapeHtml($logData['action']) ?>
                                </td>
                                <td class="col-details">
                                    <?php
                                    $details = [];
                                    
                                    // Format details based on action type
                                    $actionType = trim((string)$log->getActionType());
                                    switch ($actionType) {
                                        case 'item_added':
                                            if (isset($logData['new_value']['sku'])) {
                                                $details[] = __('SKU: %1', $escaper->escapeHtml($logData['new_value']['sku']));
                                            }
                                            if (isset($logData['new_value']['qty'])) {
                                                $details[] = __('Qty: %1', $escaper->escapeHtml($logData['new_value']['qty']));
                                            }
                                            if (isset($logData['new_value']['name'])) {
                                                $details[] = $escaper->escapeHtml($logData['new_value']['name']);
                                            }
                                            if (isset($logData['new_value']['row_total'])) {
                                                $details[] = __('Row Total: %1', $block->formatPrice($logData['new_value']['row_total']));
                                            }
                                            break;
                                            
                                        case 'item_removed':
                                            if (isset($logData['old_value']['sku'])) {
                                                $details[] = __('SKU: %1', $escaper->escapeHtml($logData['old_value']['sku']));
                                            }
                                            if (isset($logData['old_value']['qty'])) {
                                                $details[] = __('Qty: %1', $escaper->escapeHtml($logData['old_value']['qty']));
                                            }
                                            if (isset($logData['old_value']['name'])) {
                                                $details[] = $escaper->escapeHtml($logData['old_value']['name']);
                                            }
                                            if (isset($logData['old_value']['row_total'])) {
                                                $details[] = __('Row Total: %1', $block->formatPrice($logData['old_value']['row_total']));
                                            }
                                            break;
                                            
                                        case 'item_updated':
                                            if (isset($logData['old_value']['qty']) && isset($logData['new_value']['qty'])) {
                                                if ($logData['old_value']['qty'] != $logData['new_value']['qty']) {
                                                    $details[] = __('Qty: %1 → %2', 
                                                        $escaper->escapeHtml($logData['old_value']['qty']),
                                                        $escaper->escapeHtml($logData['new_value']['qty'])
                                                    );
                                                }
                                            }
                                            if (isset($logData['old_value']['price']) && isset($logData['new_value']['price'])) {
                                                if ($logData['old_value']['price'] != $logData['new_value']['price']) {
                                                    $details[] = __('Price: %1 → %2', 
                                                        $block->formatPrice($logData['old_value']['price']),
                                                        $block->formatPrice($logData['new_value']['price'])
                                                    );
                                                }
                                            }
                                            if (isset($logData['old_value']['row_total']) && isset($logData['new_value']['row_total'])) {
                                                if ($logData['old_value']['row_total'] != $logData['new_value']['row_total']) {
                                                    $details[] = __('Row Total: %1 → %2', 
                                                        $block->formatPrice($logData['old_value']['row_total']),
                                                        $block->formatPrice($logData['new_value']['row_total'])
                                                    );
                                                }
                                            }
                                            if (isset($logData['new_value']['sku'])) {
                                                $details[] = __('SKU: %1', $escaper->escapeHtml($logData['new_value']['sku']));
                                            }
                                            // Display discount if it exists in the log data (even if zero)
                                            if (isset($logData['new_value']['discount'])) {
                                                $discountValue = (float)$logData['new_value']['discount'];
                                                $discountFormatted = ($discountValue == floor($discountValue)) 
                                                    ? (string)(int)$discountValue 
                                                    : number_format($discountValue, 2);
                                                $details[] = __('Discount: %1%', $escaper->escapeHtml($discountFormatted));
                                            }
                                            break;
                                            
                                        case 'items_merged':
                                            if (isset($logData['new_value']['quote_items']) && is_array($logData['new_value']['quote_items'])) {
                                                $itemsCount = count($logData['new_value']['quote_items']);
                                                $details[] = __('%1 item(s) merged from cart', $itemsCount);
                                            }
                                            break;
                                            
                                        case 'discount_changed':
                                            $oldDiscount = $logData['old_value']['discount'] ?? null;
                                            $newDiscount = $logData['new_value']['discount'] ?? null;
                                            $reason      = $logData['new_value']['reason'] ?? null;
                                            
                                            // Format discount as percentage
                                            if ($oldDiscount !== null && $oldDiscount !== '') {
                                                $oldDiscountValue = (float)$oldDiscount;
                                                $oldDiscountFormatted = ($oldDiscountValue == floor($oldDiscountValue)) 
                                                    ? (string)(int)$oldDiscountValue . '%' 
                                                    : number_format($oldDiscountValue, 2) . '%';
                                            } else {
                                                $oldDiscountFormatted = __('None');
                                            }
                                            
                                            if ($newDiscount !== null && $newDiscount !== '') {
                                                $newDiscountValue = (float)$newDiscount;
                                                $newDiscountFormatted = ($newDiscountValue == floor($newDiscountValue)) 
                                                    ? (string)(int)$newDiscountValue . '%' 
                                                    : number_format($newDiscountValue, 2) . '%';
                                            } else {
                                                $newDiscountFormatted = __('None');
                                            }
                                            
                                            // Custom message when discount was removed due to threshold limit
                                            if ($reason === 'threshold_limit_reached') {
                                                $details[] = __(
                                                    'Threshold limit reached so discount removed. Discount: %1 → %2',
                                                    $oldDiscountFormatted,
                                                    $newDiscountFormatted
                                                );
                                            } else {
                                                $details[] = __('Discount: %1 → %2', 
                                                    $oldDiscountFormatted,
                                                    $newDiscountFormatted
                                                );
                                            }
                                            break;
                                            
                                        case 'discount_carried_over':
                                            // Get new_value data - it should be an array after unserialization
                                            // But handle case where it might still be a JSON string
                                            $newValue = $logData['new_value'] ?? null;
                                            
                                            // If new_value is a JSON string, decode it
                                            if (is_string($newValue)) {
                                                $decoded = json_decode($newValue, true);
                                                if (json_last_error() === JSON_ERROR_NONE && is_array($decoded)) {
                                                    $newValue = $decoded;
                                                } else {
                                                    $newValue = [];
                                                }
                                            }
                                            
                                            // Ensure new_value is an array
                                            if (!is_array($newValue)) {
                                                $newValue = [];
                                            }
                                            
                                            $discount = $newValue['discount'] ?? null;
                                            $surcharge = $newValue['surcharge'] ?? null;
                                            $fromQuoteId = $newValue['from_quote_id'] ?? null;
                                            $message = $newValue['message'] ?? null;
                                            
                                            // Display message if available (contains discount info and quote ID)
                                            if ($message !== null && $message !== '') {
                                                $details[] = $escaper->escapeHtml((string)$message);
                                            } elseif ($fromQuoteId !== null && $fromQuoteId !== '') {
                                                // Fallback: create message if not provided
                                                $discountText = '';
                                                if ($discount !== null && $discount !== '' && (float)$discount > 0) {
                                                    $discountValue = (float)$discount;
                                                    $discountFormatted = ($discountValue == floor($discountValue)) 
                                                        ? (string)(int)$discountValue . '%' 
                                                        : number_format($discountValue, 2) . '%';
                                                    $discountText = $discountFormatted;
                                                }
                                                if ($discountText) {
                                                    $details[] = __('Discount %1 carried over from quote #%2', 
                                                        $discountText,
                                                        $escaper->escapeHtml((string)$fromQuoteId)
                                                    );
                                                } else {
                                                    $details[] = __('Discount carried over from quote #%1', 
                                                        $escaper->escapeHtml((string)$fromQuoteId)
                                                    );
                                                }
                                            }
                                            
                                            // If no details found, show generic message
                                            if (empty($details)) {
                                                $details[] = __('Discount carried over from previous quote');
                                            }
                                            break;
                                            
                                        case 'custom_fee_changed':
                                            $oldCustomFee = $logData['old_value']['custom_fee'] ?? null;
                                            $newCustomFee = $logData['new_value']['custom_fee'] ?? null;
                                            
                                            $oldCustomFeeFormatted = ($oldCustomFee !== null && $oldCustomFee !== '') 
                                                ? $block->formatPrice((float)$oldCustomFee) 
                                                : __('None');
                                            
                                            $newCustomFeeFormatted = ($newCustomFee !== null && $newCustomFee !== '') 
                                                ? $block->formatPrice((float)$newCustomFee) 
                                                : __('None');
                                            
                                            $details[] = __('Shipping Amount: %1 → %2', 
                                                $oldCustomFeeFormatted,
                                                $newCustomFeeFormatted
                                            );
                                            break;
                                            
                                        case 'status_changed':
                                            if (isset($logData['old_value']['status']) && isset($logData['new_value']['status'])) {
                                                $details[] = __('Status: %1 → %2', 
                                                    $escaper->escapeHtml($logData['old_value']['status']),
                                                    $escaper->escapeHtml($logData['new_value']['status'])
                                                );
                                            }
                                            break;
                                            
                                        case 'quote_edited':
                                            // Show subtotal changes
                                            if (isset($logData['old_value']['subtotal']) && isset($logData['new_value']['subtotal'])) {
                                                if ($logData['old_value']['subtotal'] != $logData['new_value']['subtotal']) {
                                                    $details[] = __('Subtotal: %1 → %2', 
                                                        $block->formatPrice($logData['old_value']['subtotal']),
                                                        $block->formatPrice($logData['new_value']['subtotal'])
                                                    );
                                                }
                                            }
                                            
                                            // Show grand total changes
                                            if (isset($logData['old_value']['grand_total']) && isset($logData['new_value']['grand_total'])) {
                                                if ($logData['old_value']['grand_total'] != $logData['new_value']['grand_total']) {
                                                    $details[] = __('Grand Total: %1 → %2', 
                                                        $block->formatPrice($logData['old_value']['grand_total']),
                                                        $block->formatPrice($logData['new_value']['grand_total'])
                                                    );
                                                }
                                            }
                                            
                                            // Show items count changes
                                            if (isset($logData['old_value']['items_count']) && isset($logData['new_value']['items_count'])) {
                                                if ($logData['old_value']['items_count'] != $logData['new_value']['items_count']) {
                                                    $details[] = __('Items Count: %1 → %2', 
                                                        (int)$logData['old_value']['items_count'],
                                                        (int)$logData['new_value']['items_count']
                                                    );
                                                }
                                            }
                                            
                                            // Show individual item changes if items array exists
                                            if (isset($logData['old_value']['items']) && isset($logData['new_value']['items'])) {
                                                $oldItems = $logData['old_value']['items'];
                                                $newItems = $logData['new_value']['items'];
                                                
                                                // Check for removed items
                                                foreach ($oldItems as $itemId => $oldItem) {
                                                    if (!isset($newItems[$itemId])) {
                                                        $details[] = __('Item Removed: %1 (Qty: %2)', 
                                                            $escaper->escapeHtml($oldItem['name'] ?? $oldItem['sku'] ?? 'Item #' . $itemId),
                                                            (int)($oldItem['qty'] ?? 0)
                                                        );
                                                    }
                                                }
                                                
                                                // Check for added items
                                                foreach ($newItems as $itemId => $newItem) {
                                                    if (!isset($oldItems[$itemId])) {
                                                        $details[] = __('Item Added: %1 (Qty: %2)', 
                                                            $escaper->escapeHtml($newItem['name'] ?? $newItem['sku'] ?? 'Item #' . $itemId),
                                                            (int)($newItem['qty'] ?? 0)
                                                        );
                                                    }
                                                }
                                                
                                                // Check for updated items (qty or price changes)
                                                foreach ($newItems as $itemId => $newItem) {
                                                    if (isset($oldItems[$itemId])) {
                                                        $oldItem = $oldItems[$itemId];
                                                        $itemChanges = [];
                                                        
                                                        if (isset($oldItem['qty']) && isset($newItem['qty']) && $oldItem['qty'] != $newItem['qty']) {
                                                            $itemChanges[] = __('Qty: %1 → %2', 
                                                                (int)$oldItem['qty'],
                                                                (int)$newItem['qty']
                                                            );
                                                        }
                                                        
                                                        if (isset($oldItem['price']) && isset($newItem['price']) && $oldItem['price'] != $newItem['price']) {
                                                            $itemChanges[] = __('Price: %1 → %2', 
                                                                $block->formatPrice($oldItem['price']),
                                                                $block->formatPrice($newItem['price'])
                                                            );
                                                        }
                                                        
                                                        if (!empty($itemChanges)) {
                                                            $details[] = __('%1: %2', 
                                                                $escaper->escapeHtml($newItem['name'] ?? $newItem['sku'] ?? 'Item #' . $itemId),
                                                                implode(', ', $itemChanges)
                                                            );
                                                        }
                                                    }
                                                }
                                            }
                                            
                                            // If no specific changes found, show generic message
                                            if (empty($details)) {
                                                $details[] = __('Quote details updated');
                                            }
                                            break;
                                    }
                                    
                                    echo !empty($details) ? implode('<br>', $details) : '-';
                                    ?>
                                </td>
                                <td class="col-changed-by">
                                    <?php
                                    $changedBy = $logData['changed_by'] ?: __('System');
                                    
                                    // If admin made the change, show admin details
                                    if ($log->getAdminId()) {
                                        $adminInfo = [];
                                        if ($log->getAdminEmail()) {
                                            $adminInfo[] = $escaper->escapeHtml($log->getAdminEmail());
                                        }
                                        if ($log->getAdminRole()) {
                                            $adminInfo[] = '(' . $escaper->escapeHtml($log->getAdminRole()) . ')';
                                        }
                                        if (!empty($adminInfo)) {
                                            $changedBy = implode(' ', $adminInfo);
                                        }
                                    }
                                    
                                    echo $escaper->escapeHtml($changedBy);
                                    ?>
                                </td>
                            </tr>
                        <?php endforeach; ?>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
<?php endif; ?>

<script>
require(['jquery'], function($) {
    // Ensure quote object exists if it's expected by other scripts
    if (typeof window.quote === 'undefined') {
        window.quote = {
            submit: function() {
                var form = document.getElementById('edit_form') || document.querySelector('form[action*="quote_edit/save"]');
                if (form) {
                    form.submit();
                }
            },
            removeModificators: function() {
                // This function is called from grid.phtml
                var form = document.getElementById('edit_form') || document.querySelector('form[action*="quote_edit/save"]');
                if (form) {
                    var resetInput = document.createElement('input');
                    resetInput.type = 'hidden';
                    resetInput.name = 'reset_price_modificators';
                    resetInput.value = '1';
                    form.appendChild(resetInput);
                    form.submit();
                }
            }
        };
    }
});
</script>
