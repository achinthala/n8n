        function ProductEdit() {
            var itemId = "<?= $quoteItemId;?>";

            if (itemId) {
                const changeEvent = new Event('input', {
                    bubbles: true, // Allow the event to bubble up
                    cancelable: false // Allow the event to be canceled
                });

                var customerWidth = "<?php echo $customerWidth;?>";
                var customerLength = "<?php echo $customerLength;?>"
                var customerSquareFootage = "<?php echo $customerSquareFootage;?>";
                if (customerSquareFootage != "") {
                    var squareFootageField = document.querySelector('.square_footage_sec input[name="square_footage"]');
                    squareFootageField.value = customerSquareFootage;
                    squareFootageField.dispatchEvent(changeEvent);
                } else if (customerWidth != '' && customerLength != '') {
                    var lengthField = document.querySelector('.length_sec_in input[name="length"]');
                    var widthField = document.querySelector('.length_sec_in input[name="width"]');
                    lengthField.value = customerLength;
                    widthField.value = customerWidth;

                    lengthField.dispatchEvent(changeEvent);
                    widthField.dispatchEvent(changeEvent);
                }

                setTimeout(() => {
                    var changeEvent = new Event("change");
                    let overagePercentCheckbox = document.getElementById("overage_percent");
                    var customerOveragePercent = "<?= $customerOveragePercent;?>";

                    if (overagePercentCheckbox && customerOveragePercent == "true") {
                        overagePercentCheckbox.checked = true;
                        overagePercentCheckbox.dispatchEvent(changeEvent);
                    } else if (overagePercentCheckbox) {
                        overagePercentCheckbox.checked = true;
                        overagePercentCheckbox.dispatchEvent(changeEvent);
                        overagePercentCheckbox.checked = false;
                        overagePercentCheckbox.dispatchEvent(changeEvent);
                    }
                }, "3000");
            }
        }

