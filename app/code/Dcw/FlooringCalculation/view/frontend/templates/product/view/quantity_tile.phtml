        function initQtyField() {
            /** START - Ram - 10th Aug 2024 */
            document.querySelector(".affirm-banner-container").innerHTML = '';
            /** END - Ram - 10th Aug 2024 */
            ProductEdit();

            return {
                qty: <?= (float)($block->getProductDefaultQty() ?: 1) ?>,
                itemId: <?= $quoteItemId;?>,
                productId: '<?= (int)$product->getId() ?>',
                <?php // populate the qty when editing a product from the cart ?>
                onGetCartData: function onGetCartData(data, $dispatch) {
                    if (!this.itemId) {
                        return;
                    }
                    const cart = data && data.data && data.data.cart;
                    const quotecart = data && data.data && data.data.quotecart;
                    const cartItems = cart && cart.items;
                    const quotecartItems = quotecart && quotecart.items;
                    if (!cartItems && !quotecartItems) {
                        return;
                    }
                    const cartItem = cartItems ? cartItems.find((item) => {
                        return String(item.item_id) === String(this.itemId)
                            && String(item.product_id) === String(this.productId);
                    }) : null;
                    const quotecartItem = quotecartItems ? quotecartItems.find((item) => {
                        return String(item.item_id) === String(this.itemId)
                            && String(item.product_id) === String(this.productId);
                    }) : null;
                    const line = (cartItem && cartItem.qty != null) ? cartItem : quotecartItem;
                    if (!line || line.qty == null) {
                        return;
                    }
                    this.qty = line.qty;
                    this.total_qty = line.qty;
                    this.total_qty_tile = line.qty;
                    this.total_qty_case = line.qty;

                        this.total_price = hyva.formatPrice(
                                                        parseFloat(this.total_qty_tile) *
                                                        (parseFloat(this.final_price)*
                                                            parseFloat(this.sqft_per_tile)).toFixed(2)
                                                        );
                        this.total_regular_price = hyva.formatPrice(
                                                        parseFloat(this.total_qty_tile) *
                                                        (parseFloat(this.regular_price)*
                                                        parseFloat(this.sqft_per_tile)).toFixed(2)
                                                        );
                        $dispatch('update-qty-' + this.productId, this.qty);
                        var custompice =  this.total_price.replace('$','');
                        if (document.getElementById('pdp_hide_price')) {
                            document.getElementById('pdp_hide_price').value = custompice;
                        }
                }
            };
