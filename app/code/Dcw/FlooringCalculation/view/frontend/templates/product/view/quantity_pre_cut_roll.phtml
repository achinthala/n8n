        function initQtyFieldPreCutRoll() {
            /** START - Ram - 10th Aug 2024 */
            document.querySelector(".affirm-banner-container").innerHTML = '';
            /** END - Ram - 10th Aug 2024 */
            function findPathParam(key) {
                // get all path pairs after BASE_URL/front_name/action_path/action
                const baseUrl = (BASE_URL.substr(0, 2) === '//' ? 'http:' : '') + BASE_URL;
                const baseUrlParts = (new URL(baseUrl)).pathname.replace(/\/$/, '').split('/');
                const pathParts = window.location.pathname.split('/').slice(baseUrlParts.length + 3);
                for (let i = 0; i < pathParts.length; i += 2) {
                    if (pathParts[i] === key && pathParts.length > i) {
                        return pathParts[i + 1];
                    }
                }
            }

            return {
                qty: <?= (float)($block->getProductDefaultQty() ?: 1) ?>,
                itemId: (new URLSearchParams(window.location.search)).get('id') || findPathParam('id'),
                productId: '<?= (int)$product->getId() ?>',
                <?php // populate the qty when editing a product from the cart ?>
                onGetCartData: function onGetCartData(data, $dispatch) {
                    if (!this.itemId) {
                        return;
                    }
                    const cart = data && data.data && data.data.cart;
                    const quotecart = data && data.data && data.data.quotecart;
                    const cartItems = cart && cart.items;
                    const quotecartItems = quotecart && quotecart.items;
                    if (!cartItems && !quotecartItems) {
                        return;
                    }
                    const cartItem = cartItems ? cartItems.find((item) => {
                        return String(item.item_id) === String(this.itemId)
                            && String(item.product_id) === String(this.productId);
                    }) : null;
                    const quotecartItem = quotecartItems ? quotecartItems.find((item) => {
                        return String(item.item_id) === String(this.itemId)
                            && String(item.product_id) === String(this.productId);
                    }) : null;
                    const line = (cartItem && cartItem.qty != null) ? cartItem : quotecartItem;
                    if (!line || line.qty == null) {
                        return;
                    }
                    this.qty = line.qty;
                    this.total_qty = line.qty;

                        setTimeout(() => {
                            this.total_price = hyva.formatPrice(parseFloat(this.total_qty) * (parseFloat(this.final_price)).toFixed(2));
                            this.total_regular_price = hyva.formatPrice(parseFloat(this.total_qty) * (parseFloat(this.regular_price)).toFixed(2));
                            $dispatch('update-qty-' + this.productId, this.qty);

							if (document.getElementById('qtyPreCutRoll')) {
								const qtyVal = document.getElementById('qtyPreCutRoll').value;
								this.qty = qtyVal;
                                this.total_qty = this.qty;

                                const changeEvent = new Event('input', {
                                    bubbles: true, // Allow the event to bubble up
                                    cancelable: false // Allow the event to be canceled
                                });
                                document.querySelector('#qtyPreCutRoll').dispatchEvent(changeEvent);
                                document.getElementById("product-addtocart-button-fake").removeAttribute("disabled");
                            }
                        }, 1000);
                }
            };
        }
