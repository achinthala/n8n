        function flooringCalcDetailsPreCutRoll() {
            return {
                final_price: initPricePreCutRoll<?= /* @noEscape */ (int)$product->getId() ?>().getFinalPrice(),
                regular_price: initPricePreCutRoll<?= /* @noEscape */ (int)$product->getId() ?>().getRegularPrice(),
                total_qty: 0,
                total_price: hyva.formatPrice(initPricePreCutRoll<?= /* @noEscape */ (int)$product->getId() ?>().getFinalPrice()),
                total_regular_price: '',
                qtyFieldClick:  function () {
                    if (this.total_qty < 1 ||this.total_qty == '') {
                        this.total_qty = 0;
                    }
                },
                qtyUpdate:  function () {
                    if (this.total_qty < 1 ||this.total_qty == '') {
                        this.total_qty = 0;
                    }

                    setTimeout(() => {
                        this.calc_total_qty_sqft_price_func(this.total_qty);
                    }, 500);
                },
                qtyFieldBlur:  function () {
                    if (this.total_qty < 1 ||this.total_qty == '') {
                        this.total_qty = 0;
                    }
                },
                decrement:  function () {
                    if (this.total_qty > 1) {
                            this.total_qty--;
                        }
                    this.calc_total_qty_sqft_price_func(this.total_qty);
                },
                increment:  function () {
                    this.total_qty++;
                    this.calc_total_qty_sqft_price_func(this.total_qty);
                },
                updateTotalQtySqftPriceOnPageLoad:  function () {
                    this.calc_total_qty_sqft_price_func(0);
                    <?php  if(!isset($_REQUEST['color'])) { ?>
                    var CONTROL_INTERVAL = setInterval(function(){
                        if(document.querySelector('.product-option-value-input')){
                            document.querySelectorAll('.product-option-values').forEach(function(option_box) {
                                option_box.querySelector('.product-option-value-input').click();
                            });
                            clearInterval(CONTROL_INTERVAL);
                        }
                    }, 100);
                    <?php }?>
                },
                calc_total_qty_sqft_price_func:   function (qty_calc) {
                    const divValue = document.getElementById("finalPreCutRollPrice").innerText;;
                    var cscustomprice =  divValue.replace('$','');
                        cscustomprice = parseFloat(cscustomprice.replace(/,/g, ''));
                    this.final_price = cscustomprice;
                    this.total_qty = qty_calc;
                    const element = document.getElementById('RegularPreCutRollPrice');
                    if (element) {
                        const rPrice = document.getElementById("RegularPreCutRollPrice").innerText;
                        var rgprice =  rPrice.replace('$','');
                        rgprice = parseFloat(rgprice.replace(/,/g, ''));
                        if (rgprice >0 ) {
                            this.regular_price = rgprice;
                        } 
                    } else {
                        this.regular_price = 0;
                    }

                    this.total_price = hyva.formatPrice(
                                                        parseFloat(qty_calc) *
                                                        (parseFloat(this.final_price)).toFixed(2)
                                                        );
                    const priceDiv = document.getElementById('pricePreCutRoll');
                    if (priceDiv) {
                        priceDiv.textContent = this.total_price;
                    }

                    this.total_regular_price = hyva.formatPrice(
                                                                parseFloat(qty_calc) *
                                                                (parseFloat(this.regular_price)).toFixed(2)
                                                                );

                    //START - Ram - 10th Aug 2024
                    console.log('Affirm API Call - Start - Pre Cut Roll');
                    var affirmReqUrl = document.getElementById("affirmReqUrl").value;
                    var affirmReqKey = document.getElementById("affirmReqKey").value;
                    var pdpPriceFormat = this.total_price;
                    var affirmReqAmount = Number(pdpPriceFormat.replace(/[^0-9\.-]+/g, "")) * 100;
                    var affirmLocale = document.getElementById("affirm_locale").value;
                    var affirmLogoColor = document.getElementById("affirm_logo_color").value;
                    console.log('Affirm Req URL : '+affirmReqUrl+'/'+affirmReqKey+'?amount='+affirmReqAmount+'&field=ala&locale='+affirmLocale+'&logo_color='+affirmLogoColor);
                    fetch(affirmReqUrl+'/'+affirmReqKey+'?amount='+affirmReqAmount+'&field=ala&locale='+affirmLocale+'&logo_color='+affirmLogoColor+'&logo_type=logo&promo_external_id=promo_set_RubberFlooring&show_cta=true')
                    .then(response => {
                        if (!response.ok) {
                            throw new Error('Network response was not ok');
                        }
                        return response.json();                      
                    })
                    .then(data => {
                        console.log('Data received:', data);
                        var htmlAla = data.promo.html_ala;
                        htmlAla = htmlAla.replace("<a class='affirm-modal-trigger'>", "<a class='affirm-site-modal' x-init='affirmClick()' x-on:click='affirmClick()' aria-label='See if you qualify - Affirm Financing (opens in modal)' style='cursor: pointer;'>");
                        htmlAla = '<span class="affirm-as-low-as" data-promo-id="promo_set_RubberFlooring" data-affirm-color="blue" data-bind="attr: { \'data-amount\': affirmAmount }" data-amount="'+affirmReqAmount+'">'+htmlAla+'</span>';
                        console.log('html_ala:', htmlAla);
                        if(htmlAla=='') {
                            document.querySelector(".affirm-banner-container").innerHTML = '';   
                        } else {
                            document.querySelector(".affirm-banner-container").innerHTML = htmlAla;   
                        }
                    });
                    console.log('Affirm API Call - End');
                    //END - Ram - 10th Aug 2024
                    
                },
            }
        }
