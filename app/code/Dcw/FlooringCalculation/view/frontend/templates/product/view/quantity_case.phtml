                                    const relatedProductDialog = document.querySelector('.related-product-dialog-wrapper');
                                    const cartLink = document.getElementById('menu-cart-icon');

                                    if (relatedProductDialog) {
                                        setTimeout(() => {
                                            window.dispatchEvent(
                                                new CustomEvent('hyva-modal-show', { detail: { dialog: 'related-product-slider-dialog' } })
                                            );
                                        }, 2000);
                                    } else if (cartLink) {
                                        cartLink.click();
                                    }

                                } else {
                                    dispatchMessages([
                                        {
                                            type: messagesType,
                                            text: messagesText
                                        }
                                    ]);
                                }
                                window.dispatchEvent(new CustomEvent('amcart-loading-stop'));

                            });
                            window.dispatchEvent(new CustomEvent('reload-customer-section-data'));
                        })
                        .then(data => {
                            // window.dispatchEvent(new CustomEvent('reload-customer-section-data'));
                            // window.dispatchEvent(new CustomEvent('amcart-loading-stop'));
                        });
                    }
                },
                addToCartClickforPreCutRoll:   function () {
					const colorBoxes = document.querySelectorAll(
							'.normal_color_swatch_option .selectOptionColor'
						);
						var colorNotAvailable = 0;
						const colorerrorDiv = document.getElementById('normal-color-swatch-option-error-msg');

						colorBoxes.forEach((colorBox) => {
							if (colorBox.querySelector('.select_none label.checked')) {
								colorNotAvailable = 1;
								colorerrorDiv.textContent = 'Please select a valid available color.';
								colorerrorDiv.style.display = 'block';
								const colorSection = document.querySelector('.normal_color_swatch_option');

								if (colorSection) {
									colorSection.scrollIntoView({
										behavior: 'smooth',
										block: 'center'
									});
								}
							}
						});
						if (colorNotAvailable){
							return false;
						} else {
							colorerrorDiv.textContent = '';
							colorerrorDiv.style.display = 'none';
						}
                    const qtyVal = document.getElementById('qtyPreCutRoll').value;
                    const errorDiv = document.getElementById('qty-error-msg-pre-cut-roll');
                    if (qtyVal <= 0) {
                        errorDiv.textContent = 'Please enter a quantity greater than zero.';
                        errorDiv.style.display = 'block';
                    } else {
                        errorDiv.textContent = '';
                        errorDiv.style.display = 'none';
                        var selected_option_child_id = document.querySelector('input[name="selected_option_child_id"]').value;
                        var shiptotext = document.getElementById("s-ships").innerHTML;
                        var custompice =  document.getElementById("finalPreCutRollPrice").innerHTML;
                        custompice = custompice.replace('$','').replace(/,/g, '');

                        window.dispatchEvent(new CustomEvent('amcart-loading-start'));

                        const params = new URLSearchParams({
                            product_floor_type: "Pre Cut Roll",
                            main_product_id: "<?= /* @noEscape */ $product->getId() ?>",
                            selected_option_child_id,
                            qty: qtyVal,
                            ship_to_text: shiptotext,
                            custom_price: custompice,
                            is_updating: <?php echo $block->getRequest()->getActionName() == 'configure' ? 1 : 0; ?>,
                            item: <?= (int)$block->getRequest()->getParam('id') ?>
                        });

                        fetch(BASE_URL+'flooring/index/cartpost?form_key=' + hyva.getFormKey(), {
                            method: "POST",
                            headers: { "content-type": "application/x-www-form-urlencoded; charset=UTF-8" },
                            body: params
                        })
                        .then(response => {
                            getCustomerData(['customer'], function(data) {
                                var messagesType = data.messages.messages[0].type;
                                var messagesText = data.messages.messages[0].text;

                                if(messagesType === "success"){
                                    dispatchMessages([
                                        {
                                            type: messagesType,
                                            text: messagesText
                                        }
                                    ]);

                                    const relatedProductDialog = document.querySelector('.related-product-dialog-wrapper');
                                    const cartLink = document.getElementById('menu-cart-icon');

                                    if (relatedProductDialog) {
                                        setTimeout(() => {
                                            window.dispatchEvent(
                                                new CustomEvent('hyva-modal-show', { detail: { dialog: 'related-product-slider-dialog' } })
                                            );
                                        }, 2000);
                                    } else if (cartLink) {
                                        cartLink.click();
                                    }

                                } else {
                                    dispatchMessages([
                                        {
                                            type: messagesType,
                                            text: messagesText
                                        }
                                    ]);
                                }
                                window.dispatchEvent(new CustomEvent('amcart-loading-stop'));
                            });
                            window.dispatchEvent(new CustomEvent('reload-customer-section-data'));
                        })
                        .then(data => {
                        });
                    }
                }
            }
        }
