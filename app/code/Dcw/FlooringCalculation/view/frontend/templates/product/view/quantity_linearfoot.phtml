                    const cart = data && data.data && data.data.cart;
                    const quotecart = data && data.data && data.data.quotecart;
                    const cartItems = cart && cart.items;
                    const quotecartItems = quotecart && quotecart.items;
                    if (!cartItems && !quotecartItems) {
                        return;
                    }
                    const cartItem = cartItems ? cartItems.find((item) => {
                        return String(item.item_id) === String(this.itemId)
                            && String(item.product_id) === String(this.productId);
                    }) : null;
                    const quotecartItem = quotecartItems ? quotecartItems.find((item) => {
                        return String(item.item_id) === String(this.itemId)
                            && String(item.product_id) === String(this.productId);
                    }) : null;
                    const line = (cartItem && cartItem.qty != null) ? cartItem : quotecartItem;
                    if (!line || line.qty == null) {
                        return;
                    }
                    this.qty = line.qty;
                    this.roll_quantity = line.qty;
                    this.total_roll_quantity = line.qty;
                        this.total_sqft = parseFloat(this.roll_quantity)*
                        (parseFloat(this.roll_width)*parseFloat(this.roll_length));

                        this.total_price = hyva.formatPrice(parseFloat(this.total_sqft)*parseFloat(this.final_price));
                        this.total_regular_price = hyva.formatPrice(parseFloat(this.total_sqft)*parseFloat(this.regular_price));
