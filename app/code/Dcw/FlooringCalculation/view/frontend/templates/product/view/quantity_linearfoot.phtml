                    if (rollLength != '') {
                        var isRollLengthValid = this.isValidCustomRollLength(rollLength);
                        var isRollLengthGraterThanMax = this.validateRollLengthVsMaxRollLength(rollLength, rollLengthMax);

                        if (!isRollLengthValid) {
