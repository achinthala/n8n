						colorerrorDiv.textContent = '';
                        colorerrorDiv.style.display = 'none';
					}
					const qtyVal = document.querySelector('#custom-content input[name="qty"]').value;
					const errorDiv = document.getElementById('qty-error-msg-linearfoot');

                    var rollAvailableQuantity = document.getElementById('roll_available_quantity');
                    

                    var rollType = document.getElementById('role-type') ? document.getElementById('role-type').value : '';
                    
                    if (rollType == 'Recommended Roll Length') {
                        var roomWidth = document.getElementById('room_width') ? document.getElementById('room_width').value : '';
                        var roomLength = document.getElementById('room_length') ? document.getElementById('room_length').value : '';

                        if (roomWidth <= 0 || roomLength <= 0) {
                            errorDiv.textContent = 'Please enter a valid room width and length.';
                            errorDiv.style.display = 'block';
                            return false;
                        }

                        var totalAvailableQuantityCheck = parseFloat(roomLength) * qtyVal;
                        if(rollAvailableQuantity.value > 0 && totalAvailableQuantityCheck > rollAvailableQuantity.value) {
                            errorDiv.textContent = "You can't order more than "+rollAvailableQuantity.value+" linear feet.";
                            errorDiv.style.display = 'block';
                            return false;
                        }
                    }

                    if (rollType == 'Custom Roll Length') {
                        var rollLength = document.getElementById('roll_length') ? document.getElementById('roll_length').value : '';
                        if (rollLength <= 0) {
                            errorDiv.textContent = 'Please enter a valid roll length.';
                            errorDiv.style.display = 'block';
                            return false;
                        }

                        var totalAvailableQuantityCheck = parseFloat(rollLength) * qtyVal;
                        if(rollAvailableQuantity.value > 0 && totalAvailableQuantityCheck > rollAvailableQuantity.value) {
                            errorDiv.textContent = "You can't order more than "+rollAvailableQuantity.value+" linear feet.";
                            errorDiv.style.display = 'block';
                            return false;
                        }
                    }

					if (qtyVal <= 0) {
						errorDiv.textContent = 'Please enter a quantity greater than zero.';
                        errorDiv.style.display = 'block';
					} else {
						errorDiv.textContent = '';
                        errorDiv.style.display = 'none';
                        if (this.isProcessing) return false;
                        this.isProcessing = true;
                        setTimeout(() => {
                            this.isProcessing = false;
                        }, 500);

                        this.err_message = "";
                        var can_add_to_cart = 1;
                        if (this.rollTab == 'recommended_roll_length' && (this.room_width<=0 || this.room_length<=0)) {
                            can_add_to_cart = 0;
                        }
                        if (this.max_roll_length!="") {
                            if (this.roll_length > this.max_roll_length) {
                                    can_add_to_cart = 0;
                                    document.getElementById("qty-error-msg-linearfoot").innerHTML = "You can't order more than "+this.max_roll_length+" linear feet.";
                                    document.getElementById("qty-error-msg-linearfoot").style.display = 'block';
                                } else {
                                    document.getElementById("qty-error-msg-linearfoot").innerHTML = "";
                                    document.getElementById("qty-error-msg-linearfoot").style.display = 'none';
                                }
                        }
                        if (can_add_to_cart == 1) {
                            var cscustompice =  this.total_price.replace('$','');
                            cscustompice = parseFloat(cscustompice.replace(/,/g, ''));
                            cscustompice = cscustompice / this.roll_quantity;
                            document.getElementById('pdp-p-data').value = cscustompice;
                            document.getElementById('product-addtocart-button').click();

                            const cartlink = document.getElementById('menu-cart-icon');

                            var old_minicart_total_cart_amount = 0;
                            if (document.querySelector('.minicart-item-count .minicart-total-cart-amount') && parseInt(document.querySelector('.minicart-item-count .minicart-total-cart-amount').innerHTML) > 0) {
                                old_minicart_total_cart_amount = parseInt(document.querySelector('.minicart-item-count .minicart-total-cart-amount').innerHTML);
                            }

                            var minicart_total_cart_amount_cnt_chk = 1;

                            getCustomerData(['customer'], function(data) {
                                if (document.querySelector('.related-product-dialog-wrapper')) {
                                    var CONTROL_INTERVAL_POPUP = setInterval(function(){
                                        var new_minicart_total_cart_amount = 0;
                                        if (document.querySelector('.minicart-item-count .minicart-total-cart-amount')) {
                                            new_minicart_total_cart_amount = parseInt(document.querySelector('.minicart-item-count .minicart-total-cart-amount').innerHTML);
                                        }

                                        if(old_minicart_total_cart_amount != new_minicart_total_cart_amount || minicart_total_cart_amount_cnt_chk >=10){

                                            clearInterval(CONTROL_INTERVAL_POPUP);
                                            if(old_minicart_total_cart_amount != new_minicart_total_cart_amount){
                                                window.dispatchEvent(
                                                    new CustomEvent('hyva-modal-show', {detail: {dialog: 'related-product-slider-dialog'}})
                                                );
                                            }
                                        }
                                        minicart_total_cart_amount_cnt_chk = parseInt(minicart_total_cart_amount_cnt_chk) + 1;
                                    }, 1000);
                                }

                                window.dispatchEvent(new CustomEvent('amcart-loading-stop'));
                                var messagesType = data.messages.messages[0].type;
                                var messagesText = data.messages.messages[0].text;
                                dispatchMessages([
                                    {
                                        type: messagesType,
                                        text: messagesText
                                    }
                                ]);
                            });
                        }
				    }
                },
