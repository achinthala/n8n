/** @var View $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var Product $product */
$product = $block->getProduct();

/** @var ProductStockItem $stockItemViewModel */
$stockItemViewModel = $viewModels->require(ProductStockItem::class);
$minSalesQty        = $stockItemViewModel->getMinSaleQty($product);
$maxSalesQty        = $stockItemViewModel->getMaxSaleQty($product);

$flooringCalculationViewModel = $viewModels->require(Data::class);

$maxSalesQtyLength  = ($maxSalesQty ? strlen((string) $maxSalesQty) : 4)
    + (/* add one if decimal for separator */
    (int) $stockItemViewModel->isQtyDecimal($product));

$step = $stockItemViewModel->getQtyIncrements($product)
    ? $stockItemViewModel->getQtyIncrements($product)
    : null;

$roll_width_ft = ceil((float)$product->getRollWidth()/12);
$min_rollcut_ft = ceil((float)$product->getIncstoresPimMinRollcut()/12);
$exactlength = $product->getIncstoresPimExactLengthInches();
$exactwidth = $product->getIncstoresPimExactWidthInches();
$max_roll_length_ft = '';

if ($product->getIncstoresPimMaxRollLegnth() > 0) {
    $max_roll_length_ft = ceil((float)$product->getIncstoresPimMaxRollLegnth()/12);
}

$flooringCalculationBlock = $block->getLayout()->createBlock(\Dcw\FlooringCalculation\Block\Index::class);
$flooringCalculationHelper = $flooringCalculationBlock->flooringCalculationHelper();

$request = $flooringCalculationViewModel->getRequest();

$quoteItemId = (int)$request->getParam('id');
$editProductId = (int)$request->getParam('product_id');

$recommendedTypeActive = $customTypeActive = false;
$roomLength = $customLength = $lineItemUnitQuantity= $lineItemPrice = $customerRoomWidth = $customerRoomLength = "";
$customerRoomLengthGroup = $quoteItemQty = "";

if ($quoteItemId && $editProductId) {
    $cart = $flooringCalculationViewModel->getCart();
    $pricingHelper = $flooringCalculationViewModel->getPricingHelper();

    // Get the quote from the cart
    $quote = $cart->getQuote();
    $quoteItem = $quote->getItemById($quoteItemId);

    $getPdpLineItem = $quoteItem !== false ? $quoteItem->getData('pdp_line_item') : null;

    if ($getPdpLineItem) {
        $quoteItemQty = $quoteItem->getQty();
        // Decode the JSON string into an associative array
        $data = json_decode($getPdpLineItem, true);
        $roomLength = $data['RoomLength'] ?? '';
        $customLength = $data['CustomLength'] ?? '';
        $lineItemUnitQuantity = $data['LineItemUnitQuantity'] ?? '';
        $lineItemPrice = $data['LineItemPrice'] ?? '';

        $customerRoomWidth = $data['CustomerRoomWidth'] ?? '';
        $customerRoomLength = $data['CustomerRoomLength'] ?? '';
        $customerRoomLengthGroup = $data['CustomerRoomLengthGroup'] ?? '';

        $lineItemPrice = $pricingHelper->currency($lineItemPrice, true, false);

        $rollType = $data['RollType'] ?? '';

        if ($rollType == 'Recommended Roll Length') {
            $recommendedTypeActive = true;
        }

        if ($rollType == 'Custom Roll Length') {
            $customTypeActive = true;
        }
    }
}
