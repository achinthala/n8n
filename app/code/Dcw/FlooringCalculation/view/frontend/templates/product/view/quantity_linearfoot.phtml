                updateRollQtyLength:   function () {
                    if (document.getElementById('customer-room-length-group')) {
                        document.getElementById('customer-room-length-group').value = this.roll_length_group;
                    }

                    if (this.roll_length_group == 1) {
                        this.roll_quantity = this.recommended_roll_quantity1;
                        this.roll_length = this.recommended_roll_length1;
                    } else {
                        this.roll_quantity = this.recommended_roll_quantity2;
                        this.roll_length = this.recommended_roll_length2;
                    }

                    if (this.roll_quantity < 1 || this.roll_quantity == '') {
                        this.roll_quantity = 0
                    }
                    if (this.roll_length <= this.min_rollcut || this.roll_length == '') {
                        this.roll_length = this.min_rollcut;
                    }

                    this.calcTotalSqftPrice();
                },
                calcTotalSqftPrice:   function () {
                    if (this.rollTab == 'custom_roll_length' ||
                        (this.rollTab == 'recommended_roll_length' &&
                            (this.room_width > 0 && this.roll_length_group == 1) ||
                            (this.room_length > 0 && this.roll_length_group == 2))) {


                        if (this.rollTab == 'custom_roll_length' && document.getElementById('roll_length')) {
                            this.roll_length = this.roundValue(document.getElementById('roll_length').value);
                        }

                        if (this.roll_length == "") {
                            this.roll_length = this.min_rollcut;
                        }

                        this.quoteItemPageLoaded = this.isPageLoaded();

                        if (this.quoteItemRoomLength > 0 && this.quoteItemPageLoaded != 1) {
                            this.roll_length = this.quoteItemRoomLength;
                        }

                        if (this.quoteItemQty > 0 && this.quoteItemPageLoaded != 1) {
                            this.roll_quantity = this.quoteItemQty;
                        }

                        this.total_sqft = parseFloat(this.roll_quantity)*
                        (parseFloat(this.roll_width)*parseFloat(this.roll_length));

                        this.total_roll_quantity = this.roll_quantity;
                        this.total_price = hyva.formatPrice(parseFloat(this.total_sqft)*parseFloat(this.final_price));
                        this.total_regular_price = hyva.formatPrice(parseFloat(this.total_sqft)*parseFloat(this.regular_price));
                    } else {
                        this.total_sqft = 0;
                        this.total_roll_quantity = 0;
                        this.total_price = hyva.formatPrice(parseFloat(0));
                        this.total_regular_price = hyva.formatPrice(parseFloat(0));
                    }

                    //if(this.room_width >0){
                        if (document.getElementById('room-width')) {
                            document.getElementById('room-width').value = this.roll_width;
                        }

                        var roomWidth = document.getElementById('room_width');
                        if (roomWidth) {
                            document.getElementById('customer-room-width').value = roomWidth.value;
                        }

                        var roomLength = document.getElementById('room_length');
                        if (roomLength) {
                            document.getElementById('customer-room-length').value = roomLength.value;
                        }

                    //}

                    //if(this.room_length >0){
                        if (document.getElementById('room-length')) {
                            document.getElementById('room-length').value = this.roll_length;
                        }
                    //}

                    if(this.rollTab!=""){
                        if(this.rollTab == 'recommended_roll_length'){
                            document.getElementById('role-type').value = 'Recommended Roll Length';
                        } else {
                            document.getElementById('role-type').value = 'Custom Roll Length';
                        }
                    }
                    if(this.final_price > 0){
                        document.getElementById('price-per-sqft').value = "$"+this.final_price+" /sqft";
                    }

                    var rollsizes = this.total_roll_quantity+" roll(s) "+this.roll_width+"′ × "+this.roll_length+" ′ ea.";
                    document.getElementById('roll-size').value = rollsizes;

                    var custompice =  this.total_price.replace('$','');
                    if(document.getElementById('pdp_hide_price')){
                        document.getElementById('pdp_hide_price').value = custompice;
                    }
                    if(document.querySelector('input[name="custom_length"]')){
                        var custom_length = this.roundValue(document.getElementById('roll_length').value);
                        if(custom_length <= this.min_rollcut){
                            custom_length = this.min_rollcut;
                        }
                        document.querySelector('input[name="custom_length"]').value = custom_length;
                        //START - Ram - 10th Aug 2024
                        var affirmReqUrl = document.getElementById("affirmReqUrl").value;
                        var affirmReqKey = document.getElementById("affirmReqKey").value;
                        var pdpPriceFormat = this.total_price;
                        var affirmReqAmount = Number(pdpPriceFormat.replace(/[^0-9\.-]+/g, "")) * 100;
                        var affirmLocale = document.getElementById("affirm_locale").value;
                        var affirmLogoColor = document.getElementById("affirm_logo_color").value;

                        fetch(affirmReqUrl+'/'+affirmReqKey+'?amount='+affirmReqAmount+'&field=ala&locale='+affirmLocale+'&logo_color='+affirmLogoColor+'&logo_type=logo&promo_external_id=promo_set_RubberFlooring&show_cta=true')
                        .then(response => {
                            if (!response.ok) {
                                throw new Error('Network response was not ok');
                            }
                            return response.json();
                        })
                        .then(data => {
                            var htmlAla = data.promo.html_ala;
                            htmlAla = htmlAla.replace("<a class='affirm-modal-trigger'>", "<a class='affirm-site-modal' x-init='affirmClick()' x-on:click='affirmClick()' aria-label='See if you qualify - Affirm Financing (opens in modal)' style='cursor: pointer;'>");
                            htmlAla = '<span class="affirm-as-low-as" data-promo-id="promo_set_RubberFlooring" data-affirm-color="blue" data-bind="attr: { \'data-amount\': affirmAmount }" data-amount="'+affirmReqAmount+'">'+htmlAla+'</span>';
                            if(htmlAla=='')
                            {
                                document.querySelector(".affirm-banner-container").innerHTML = '';
                            }
                            else
                            {
                                document.querySelector(".affirm-banner-container").innerHTML = htmlAla;
                            }
                        });
                        //END - Ram - 10th Aug 2024
                    }
