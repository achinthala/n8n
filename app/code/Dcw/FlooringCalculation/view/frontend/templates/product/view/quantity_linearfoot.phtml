							colorNotAvailable = 1;
							colorerrorDiv.textContent = 'Please select a valid available color.';
                            colorerrorDiv.style.display = 'block';
							const colorSection = document.querySelector('.normal_color_swatch_option');

							if (colorSection) {
								colorSection.scrollIntoView({
									behavior: 'smooth',
									block: 'center'
								});
							}
