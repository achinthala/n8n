<?php
/**
 * Bazaarvoice FTP Import Test Connection Template
 *
 * @var \Dcw\BazaarvoiceFtpImport\Block\Adminhtml\System\Config\TestConnection $block
 */
?>
<div class="actions">
    <button type="button" class="action-default scalable" id="test-ftp-connection">
        <span><?= $block->escapeHtml(__('Test Connection')) ?></span>
    </button>
    <div id="test-connection-result" style="margin-top: 10px;"></div>
</div>

<script type="text/javascript">
require(['jquery'], function($) {
    $('#test-ftp-connection').on('click', function() {
        var button = $(this);
        var resultDiv = $('#test-connection-result');
        
        button.prop('disabled', true);
        button.find('span').text('<?= $block->escapeJs(__('Testing...')) ?>');
        resultDiv.html('');
        
        $.ajax({
            url: '<?= $block->escapeUrl($block->getTestConnectionUrl()) ?>',
            type: 'POST',
            dataType: 'json',
            data: {
                'form_key': '<?= $block->escapeJs($block->getFormKey()) ?>'
            },
            success: function(response) {
                if (response.success) {
                    resultDiv.html('<div class="message message-success success">' + 
                        '<div data-ui-id="messages-message-success">' + 
                        response.message + 
                        '</div></div>');
                } else {
                    resultDiv.html('<div class="message message-error error">' + 
                        '<div data-ui-id="messages-message-error">' + 
                        response.message + 
                        '</div></div>');
                }
            },
            error: function() {
                resultDiv.html('<div class="message message-error error">' + 
                    '<div data-ui-id="messages-message-error">' + 
                    '<?= $block->escapeJs(__('An error occurred while testing the connection.')) ?>' + 
                    '</div></div>');
            },
            complete: function() {
                button.prop('disabled', false);
                button.find('span').text('<?= $block->escapeJs(__('Test Connection')) ?>');
            }
        });
    });
});
</script>
