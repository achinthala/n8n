<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Amasty\Faq\Block\Lists\QuestionsList">
        <!-- Sorting -->
        <plugin name="dcw_faq_sort_product_questions"
                type="Dcw\Faq\Plugin\ProductQuestionSortPlugin"/>
        <!-- Disable pagination -->
        <plugin name="dcw_faq_disable_limit"
                type="Dcw\Faq\Plugin\DisableFaqLimitPlugin"/>
    </type>
    <type name="Amasty\Faq\Block\Forms\AskQuestion">
        <plugin name="dcw_faq_ask_question_product_id"
                type="Dcw\Faq\Plugin\AskQuestionProductIdPlugin"/>
    </type>
    <type name="Amasty\Faq\Block\Lists\Pager">
        <plugin name="dcw_faq_search_pager_product_id"
                type="Dcw\Faq\Plugin\SearchPagerProductIdPlugin"/>
    </type>
    <type name="Amasty\Faq\Block\Lists\CategoryList">
        <plugin name="dcw_faq_hide_categories_on_product_search"
                type="Dcw\Faq\Plugin\HideCategoriesOnProductSearchPlugin"/>
    </type>
</config>
