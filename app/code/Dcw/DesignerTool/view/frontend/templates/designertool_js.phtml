            $('#'+color_position+'_color').attr('data-swatch_image',$(this).attr('data-swatch_image'));
            $('#'+color_position+'_color').attr('data-color_type',$(this).attr('data-color_type'));
            $('#'+color_position+'_color').val($(this).attr('data-value'));
            
            if($(this).attr('data-color_type') == 'swatch_color_url') {
                $('.'+color_position+'_container').find('.color_img_box_'+selectedVariantId).html('<img src="'+$(this).attr('data-swatch_image')+'"/>');
            }
            $('.'+color_position+'_container').find('.color_title_'+selectedVariantId).html($(this).attr('data-color_title'));

            if ($('#design_pattern').val() != 'Single') {
                $('.color_position_'+selectedVariantId+':checked').trigger('click');
            }

            edgeCornerHideShow(selectedVariantId);

            //=====  If choosed color not same as unchecked color_position  END =======
        //}
    });
    /* ====== click on color from list   STOP ========= */

    $('.color_img_box').click(function(e) {
        var selectedVariantId = getCookie('design_selected_variant_id');

        var colorPosition = $(this).parent().find('.color_position_'+selectedVariantId);
        colorPosition.prop("checked", true);

        if (colorPosition.is(':checked')) {
            return false;
        }
        
        var colorOptionId = colorPosition.attr('data-color_option_id');
        $('.choose_color_'+selectedVariantId+'_'+colorOptionId).trigger('click');
    });
    /* ====== click on primary & secondary color   START ========= */
    $('.color_position').click(function(e) {
        var selectedVariantId = getCookie('design_selected_variant_id');
        let grid_width_tiles = $('.grid_width_tiles').text();
        let grid_length_tiles = $('.grid_length_tiles').text();
        let color_position = $('.color_position_'+selectedVariantId+':checked').attr('data-color_position');
