jQuery(function($) {
    $('#choose_variant').on('change', function() {
        var selectedValue = jQuery(this).val();
        // Hide all divs initially
        $('.color_group').hide();
        $('.color_group_'+selectedValue).show();

        setCookie('design_selected_variant_id', selectedValue);
        
        $('.color_position_'+selectedValue).eq(0).prop("checked", true);
        var primaryColorSwatch  = $('.choose_color_'+selectedValue).eq(0).attr('data-swatch_image');
        var primaryColorTitle  = $('.choose_color_'+selectedValue).eq(0).attr('data-color_title');
        $(".color_img_box_"+selectedValue).eq(0).html('<img src="'+primaryColorSwatch+'"/>');
        $(".color_title_"+selectedValue).eq(0).html(primaryColorTitle);

        $('.color_position_'+selectedValue).eq(1).prop("checked", true);
        var secondaryColorSwatch  = $('.choose_color_'+selectedValue).eq(1).attr('data-swatch_image');
        var secondaryColorTitle  = $('.choose_color_'+selectedValue).eq(1).attr('data-color_title');
