// Function to dynamically group and display data by pattern type
function displayPatternByType(data) {
    // Create an object to group by pattern type
    let groupedPatterns = {};

    // Group patterns by their type
    data.forEach(pattern => {
        if (!groupedPatterns[pattern.type]) {
            groupedPatterns[pattern.type] = [];
        }
        groupedPatterns[pattern.type].push(pattern);
    });

    // Display each pattern type separately
    for (let patternType in groupedPatterns) {
        jQuery('.designer_cart_items').append('<h3 class="text-size16 font-semibold my-4">'+patternType+'</h3>');
        groupedPatterns[patternType].forEach(pattern => {
            jQuery('.designer_cart_items').append(pattern.html);
        });
    }
}

