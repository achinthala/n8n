    /* ====== click on primary & secondary color   STOP ========= */
    
    /* ====== click on swap button   START ========= */
    $('.swap_button').click(function() {
        var selectedVariantId = getCookie('design_selected_variant_id');

        var primaryRadio = $('.color_position_'+selectedVariantId+':first');
