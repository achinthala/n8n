function singlePatternImageColorAdd(e) {
    var selectedVariantId = getCookie('design_selected_variant_id');
    
    $('input[name="choose_pattern"][value="Single"]').prop("checked",true);
    $('#design_pattern').val('Single');
    var color_position = $('.color_position:checked').attr('data-color_position');
    var colorOptionId = $('.color_position:checked').attr('data-color_option_id');

    var singlePatternSwatch = selectedVariantId+'_'+colorOptionId;
    
    if($('#design_'+color_position+'_color_type').val() == 'swatch_color_url') {
        var single_img = new Image;
        single_img.src = $('.color_position_'+selectedVariantId+':checked').attr('data-swatch_image');
    }

    var rect = [];
    var rect = collides(rects, e.offsetX, e.offsetY);
    if (rect) {
        if (color_in_cell[rect.row+'_'+rect.column] != $("#design_"+color_position+"_color_title").val()) {
            context.clearRect(rect.x, rect.y, rect.w, rect.h);

            if ($('#design_'+color_position+'_color_type').val() == 'swatch_color_url') {
                context.drawImage(single_img, rect.x, rect.y, rect.w, rect.h);
            }

            color_in_cell[rect.row+'_'+rect.column] = singlePatternSwatch;

            color_in_cell[rect.row+'_'+rect.column+'_child'] = getCookie('design_'+color_position+'_child_product');

            design_single_pattern_tiles_arr['color_title_'+rect.row+'_'+rect.column] = singlePatternSwatch;

            $('.color_position:checked').trigger('click');
        }

    } else {
        console.log('no collision');
    }
}

function collides(rects, x, y) {
    var isCollision = false;
    for (var i = 0, len = rects.length; i < len; i++) {
        var left = rects[i].x, right = rects[i].x+rects[i].w;
        var top = rects[i].y, bottom = rects[i].y+rects[i].h;
        if (right >= x
            && left <= x
            && bottom >= y
            && top <= y) {
            isCollision = rects[i];
        }
    }
    return isCollision;
}


