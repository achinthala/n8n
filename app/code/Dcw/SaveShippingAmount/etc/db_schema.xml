<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="quote_address" resource="checkout" engine="innodb" comment="Quote Address Table">
        <column xsi:type="varchar" name="shipping_charge_api" nullable="true" length="255" comment="Amasty Quote ID"/>
    </table>
    <table name="amasty_quote" resource="checkout" engine="innodb" comment="Quote Address Table">
        <column xsi:type="varchar" name="shipping_amount" nullable="true" length="255" comment="shipping_amount"/>
        <!-- New tax_amount column -->
        <column xsi:type="varchar" name="tax_amount" nullable="true" length="255" comment="Tax Amount"/>
    </table>
    
</schema>

