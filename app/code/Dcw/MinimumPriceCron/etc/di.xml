<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Configure custom logger for minimum price cron -->
    <type name="Dcw\MinimumPriceCron\Cron\MinimumPricedSimpleProduct">
        <arguments>
            <argument name="logger" xsi:type="object">MinimumPriceCronLogger</argument>
        </arguments>
    </type>

    <type name="Dcw\MinimumPriceCron\Model\ProductDataUpdater">
        <arguments>
            <argument name="logger" xsi:type="object">MinimumPriceCronLogger</argument>
        </arguments>
    </type>

    <!-- Virtual type for custom logger -->
    <virtualType name="MinimumPriceCronLogger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">minimumPriceCron</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">MinimumPriceCronLogHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Handler for custom logger -->
    <virtualType name="MinimumPriceCronLogHandler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/minimum_calculated_price_cron.log</argument>
        </arguments>
    </virtualType>

    <!-- Stock Manager Logger -->
    <type name="Dcw\MinimumPriceCron\Model\StockManager">
        <arguments>
            <argument name="logger" xsi:type="object">StockManagerLogger</argument>
        </arguments>
    </type>

    <virtualType name="StockManagerLogger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">stockManager</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">StockManagerLogHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="StockManagerLogHandler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/stock_status_change.log</argument>
        </arguments>
    </virtualType>
</config>

