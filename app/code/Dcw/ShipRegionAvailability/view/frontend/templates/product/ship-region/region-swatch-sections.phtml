                    <div class="active-color-meta">
                        <div class="dcw-ship-region-active-top-row">
                            <div class="active-color-top">
                                <span class="label"><?= $escaper->escapeHtml(__('Selected:')) ?></span>
                                <span class="dcw-ship-region-active-color"
