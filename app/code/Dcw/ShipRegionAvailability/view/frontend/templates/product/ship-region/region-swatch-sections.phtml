use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Magento\Swatches\ViewModel\Product\Renderer\Configurable as ConfigurableViewModel;

/** @var Template $block */
/** @var Escaper $escaper */

$attributes = $block->getData('attributes');
$swatchRendererViewModel = $block->getData('swatch_renderer_view_model');
$getQuickShipProductCount = $block->getData('quick_ship_color_ids') ?? [];

if (!$attributes || !$swatchRendererViewModel) {
    return;
}

$hasQuickShip = is_array($getQuickShipProductCount) && count($getQuickShipProductCount) > 0;
$swatchImageUrlJson = (string) ($block->getData('swatch_image_url') ?? '');
$productId = (int) ($block->getData('product_id') ?? 0);

$shipRegionSwatchBlock = $block->getLayout()->createBlock(Template::class)
    ->setTemplate('Dcw_ShipRegionAvailability::product/ship-region/swatch-item.phtml')
    ->setData(['product_id' => $productId]);

foreach ($attributes as $attribute):
    $attributeId = (int) $attribute->getAttributeId();
    $productAttribute = $attribute->getProductAttribute();
    if (!$swatchRendererViewModel->isSwatchAttribute($productAttribute)
        || $productAttribute->getAttributeCode() !== 'incstores_pim_color_axis') {
        continue;
    }
    $attributeCode = $productAttribute->getAttributeCode();
    ?>
    <template x-if="showSwatches && shipRegionZipActive && customerRegionCode">
        <div class="dcw-ship-region-sections"
             data-ship-region-swatch-images="<?= $escaper->escapeHtmlAttr($swatchImageUrlJson) ?>">
