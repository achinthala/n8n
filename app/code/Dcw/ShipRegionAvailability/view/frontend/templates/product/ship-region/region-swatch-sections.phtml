            <div class="dcw-ship-region-section dcw-ship-region-section--near region-section">
                <span class="dcw-ship-region-section__badge region-badge">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <polygon points="13,2 3,14 12,14 11,22 21,10 12,10"/>
                    </svg>
                    <?= $escaper->escapeHtml(__('Fastest & Lowest Shipping')) ?>
