                <div class="dcw-ship-region-section__header region-header">
                    <h3 class="dcw-ship-region-section__title">
                        <?= $escaper->escapeHtml(__('Ships from our closest manufacturing facilities')) ?>
                    </h3>
                    <span class="color-count"
                          x-text="(selectedValues && countShipRegionSectionColors('near', '<?= $escaper->escapeJs($attributeCode) ?>', <?= $attributeId ?>)) + ' colors'"></span>
                </div>
                <p class="dcw-ship-region-section__sub region-subtitle">
                    <?= $escaper->escapeHtml(__('In stock at the warehouse closest to you — fastest delivery and lowest shipping cost.')) ?>
                </p>

                <div class="active-color-line dcw-ship-region-active-line dcw-ship-region-active-line--near"
