<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Dcw_ShipRegionAvailability::css/ship-region-pdp.css"/>
    </head>
    <body>
        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template"
                   name="dcw.ship.region.swatch.patch"
                   template="Dcw_ShipRegionAvailability::product/ship-region/swatch-options-patch.phtml"
                   after="product.info.options.swatch.js"
                   before="product.info.options.configurable.js.dcw">
                <arguments>
                    <argument name="view_model" xsi:type="object">Dcw\ShipRegionAvailability\ViewModel\Product\ShipRegionAvailability</argument>
                </arguments>
            </block>
        </referenceContainer>
        <!-- Rendered in product-info.phtml (after Order Free Sample, before configurable options) -->
        <referenceBlock name="product.info">
            <block class="Magento\Framework\View\Element\Template"
                   name="dcw.ship.region.panel"
                   template="Dcw_ShipRegionAvailability::product/ship-region/panel.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Dcw\ShipRegionAvailability\ViewModel\Product\ShipRegionAvailability</argument>
                </arguments>
            </block>
        </referenceBlock>
        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template"
                   name="dcw.ship.region.integration"
                   template="Dcw_ShipRegionAvailability::product/ship-region/integration.phtml"
                   after="product.info.options.configurable.js.dcw">
                <arguments>
                    <argument name="view_model" xsi:type="object">Dcw\ShipRegionAvailability\ViewModel\Product\ShipRegionAvailability</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
