<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">dcw_ship_region_form.dcw_ship_region_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Region Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <namespace>dcw_ship_region_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>dcw_ship_region_form.dcw_ship_region_form_data_source</dep>
        </deps>
        <buttons>
            <button name="back">
                <url path="dcw_shipregion/region/index"/>
                <class>back</class>
                <label translate="true">Back</label>
            </button>
            <button name="save">
                <url path="dcw_shipregion/region/save"/>
                <class>save primary</class>
                <label translate="true">Save</label>
            </button>
            <button name="save_and_continue">
                <url path="dcw_shipregion/region/save"/>
                <class>save</class>
                <label translate="true">Save and Continue Edit</label>
            </button>
        </buttons>
    </settings>
    <dataSource name="dcw_ship_region_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="dcw_shipregion/region/save"/>
        </settings>
        <dataProvider class="Dcw\ShipRegionAvailability\Ui\DataProvider\Region\Form\DataProvider"
                      name="dcw_ship_region_form_data_source">
            <settings>
                <requestFieldName>region_id</requestFieldName>
                <primaryFieldName>region_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label/>
        </settings>
        <field name="region_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>region_id</dataScope>
            </settings>
        </field>
        <field name="code" sortOrder="10" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Region Code</label>
                <dataScope>code</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="name" sortOrder="20" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Region Name</label>
                <dataScope>name</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="status" sortOrder="30" formElement="select">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Status</label>
                <dataScope>status</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Dcw\ShipRegionAvailability\Model\Config\Source\Status"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="sort_order" sortOrder="40" formElement="input">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Sort Order</label>
                <dataScope>sort_order</dataScope>
            </settings>
        </field>
    </fieldset>
</form>
