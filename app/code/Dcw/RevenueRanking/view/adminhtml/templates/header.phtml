<div class="revenue-ranking-actions">
    <button type="button" class="action-secondary" id="import-manual-adjustment">
        <span><?= $block->escapeHtml(__('Import Manual Adjustments')) ?></span>
    </button>
    <button type="button" class="action-secondary" id="download-sample-csv">
        <span><?= $block->escapeHtml(__('Download Sample CSV')) ?></span>
    </button>
    <form method="POST" action="<?= $block->escapeUrl($block->getUrl('revenue_ranking/index/refresh')) ?>" style="display: inline-block; margin-left: 10px;">
        <input type="hidden" name="form_key" value="<?= $block->escapeHtml($block->getFormKey()) ?>">
        <button type="submit" class="action-primary">
            <span><?= $block->escapeHtml(__('Refresh Revenue Data')) ?></span>
        </button>
    </form>
</div>

<div id="import-modal" style="display: none;">
    <div class="modal-inner-wrap">
        <div class="modal-header">
            <h1 class="modal-title"><?= $block->escapeHtml(__('Import Manual Adjustments')) ?></h1>
        </div>
        <div class="modal-content">
            <form id="import-form" enctype="multipart/form-data">
                <div class="field required">
                    <label class="label" for="csv_file">
                        <span><?= $block->escapeHtml(__('CSV File')) ?></span>
                    </label>
                    <div class="control">
                        <input type="file" name="csv_file" id="csv_file" accept=".csv" required>
                                                                                    <div class="note">
                                    <?= $block->escapeHtml(__('Select a CSV file with SKU and Manual Adjustment columns. Leave Manual Adjustment empty to use base revenue.')) ?>
                                </div>
                    </div>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="action-primary" id="start-import">
                <span><?= $block->escapeHtml(__('Import')) ?></span>
            </button>
            <button type="button" class="action-secondary" id="cancel-import">
                <span><?= $block->escapeHtml(__('Cancel')) ?></span>
            </button>
        </div>
    </div>
</div>

<script>
require(['jquery'], function($) {
    'use strict';
    
    // Wait for page to be fully loaded
    $(window).on('load', function() {
        setTimeout(function() {
            var importModal = $('#import-modal');
            var importForm = $('#import-form');
            var importButton = $('#import-manual-adjustment');
            var downloadButton = $('#download-sample-csv');
            var startImportButton = $('#start-import');
            var cancelButton = $('#cancel-import');
            
            // Check if elements exist before initializing
            if (importModal.length === 0 || importButton.length === 0) {
                console.log('Import elements not found');
                return;
            }
            
            // Simple modal implementation without Magento modal
            var isModalOpen = false;
            
            // Open modal
            importButton.on('click', function() {
                importModal.show();
                isModalOpen = true;
            });
            
            // Download sample CSV
            downloadButton.on('click', function() {
                window.location.href = '<?= $block->escapeUrl($block->getUrl('revenue_ranking/index/downloadSample')) ?>';
            });
            
                            // Start import
                startImportButton.on('click', function() {
                    var formData = new FormData(importForm[0]);
                    
                    // Add form key to the request
                    formData.append('form_key', '<?= $block->escapeJs($block->getFormKey()) ?>');

                    if (!formData.get('csv_file')) {
                        alert('<?= $block->escapeJs(__('Please select a CSV file.')) ?>');
                        return;
                    }

                    startImportButton.prop('disabled', true).find('span').text('<?= $block->escapeJs(__('Importing...')) ?>');

                    $.ajax({
                        url: '<?= $block->escapeUrl($block->getUrl('revenue_ranking/index/import')) ?>',
                        type: 'POST',
                        data: formData,
                        processData: false,
                        contentType: false,
                        showLoader: true,
                    success: function(response) {
                        if (response.success) {
                            var message = '<?= $block->escapeJs(__('Import completed successfully. %1 records updated.')) ?>'.replace('%1', response.updated_count);
                            if (response.attribute_updated_count) {
                                message += ' <?= $block->escapeJs(__('%1 product attributes updated.')) ?>'.replace('%1', response.attribute_updated_count);
                            }
                            alert(message);
                            location.reload();
                        } else {
                            alert('<?= $block->escapeJs(__('Import failed: %1')) ?>'.replace('%1', response.message));
                        }
                    },
                    error: function() {
                        alert('<?= $block->escapeJs(__('An error occurred during import.')) ?>');
                    },
                    complete: function() {
                        startImportButton.prop('disabled', false).find('span').text('<?= $block->escapeJs(__('Import')) ?>');
                    }
                });
            });
            
            // Cancel import
            cancelButton.on('click', function() {
                importModal.hide();
                importForm[0].reset();
                isModalOpen = false;
            });
            
            // Close modal when clicking outside
            importModal.on('click', function(e) {
                if (e.target === this) {
                    importModal.hide();
                    importForm[0].reset();
                    isModalOpen = false;
                }
            });
            
        }, 1000); // Wait 1 second for grid to load
    });
});
</script>

