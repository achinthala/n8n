    // Get ALL filtered product IDs (not just current page)
    function getAllFilteredProductIds() {
        // Try to get all product IDs from various sources
        let allProductIds = [];
        
        // Method 1: Try to get from all product containers (including hidden/paginated ones)
        const allProductElements = document.querySelectorAll('[data-product-id]');
        const uniqueIds = new Set();
        
        allProductElements.forEach(element => {
            const productId = element.getAttribute('data-product-id');
            if (productId && !uniqueIds.has(productId)) {
                uniqueIds.add(productId);
                allProductIds.push(productId);
            }
        });
        
        // Method 2: If we don't have enough, try to get from data attributes or other sources
        if (allProductIds.length < 25) {
            // Try to get from toolbar or other data sources
            const toolbarElement = document.querySelector('.toolbar, #toolbar-amount, .toolbar-amount');
            if (toolbarElement) {
                // Look for data attributes that might contain all product IDs
                const dataProductIds = toolbarElement.getAttribute('data-product-ids');
                if (dataProductIds) {
                    const additionalIds = dataProductIds.split(',').map(id => id.trim()).filter(id => id);
                    additionalIds.forEach(id => {
                        if (!uniqueIds.has(id)) {
                            uniqueIds.add(id);
                            allProductIds.push(id);
                        }
                    });
                }
            }
        }
        return allProductIds;
    }
    
    // Get toolbar count for comparison
    function getToolbarCount() {
        const toolbarElement = document.querySelector('#toolbar-amount .toolbar-number, .toolbar .amount, .toolbar-number');
        if (toolbarElement) {
            const text = toolbarElement.textContent.replace(/,/g, '');
            const count = parseInt(text) || 0;
            
            return count;
        }
        return 0;
    }
    
    // AJAX function to get product data from backend
    async function getProductData() {
        
        // Get ALL filtered product IDs (not just current page)
        const allFilteredProductIds = getAllFilteredProductIds();
        const toolbarCount = getToolbarCount();
        
        try {
            const response = await fetch('/revenueranking/ajax/productRevenue', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: new URLSearchParams({
                    'action': 'get_product_data',
                    'current_url': window.location.href,
                    'current_page_product_ids': allFilteredProductIds.join(','),
                    'toolbar_count': toolbarCount
                })
            });
            
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const data = await response.json();
            
            return data;
            
        } catch (error) {
            return {
                success: false,
                error: error.message
            };
        }
    }
    
