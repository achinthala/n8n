    async function getAllFilteredProductIdsCustom(categoryId) {
          const endpoint = "/graphql"; // GraphQL endpoint (relative or absolute URL)
          const pageSize = 100;
          let currentPage = 1;
          let allProducts = [];
          let totalPages = 1;
          
          // Build filters dynamically
          const filters = buildGraphQlFilters(categoryId);
		  if (filters.srsltid) {
			delete filters.srsltid;
		  }
		  if (filters.spotlight) {
			delete filters.spotlight;
		  }
		  if (filters.category_id && filters.category_id.eq === "null") {
			delete filters.category_id;
		  }
		  if (filters.revenue_ranking) {
			delete filters.revenue_ranking;
		  }

          const query = `
    query getFilteredProducts($currentPage: Int!, $pageSize: Int!, $filters: ProductAttributeFilterInput!) {
      products(
        filter: $filters
        pageSize: $pageSize
        currentPage: $currentPage
      ) {
        items {
          id
          sku
          revenue_ranking
        }
        page_info {
          current_page
          total_pages
        }
      }
    }
  `;

          do {
            const response = await fetch('/graphql', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                query,
                variables: { currentPage, pageSize, filters }
              })
            });

            const result = await response.json();
            const data = result.data.products;

            if (data && data.items) {
              allProducts.push(...data.items);
              totalPages = data.page_info.total_pages;
            } else {
              break;
            }

            currentPage++;
          } while (currentPage <= totalPages);

          return allProducts;
    }
    
    function buildGraphQlFilters(categoryId) {
      const activeFilters = getActiveFiltersFromUrl();

      // Start with category filter
      const gqlFilters = {
        category_id: { eq: String(categoryId) }
      };

      // Add dynamic attribute filters
      Object.entries(activeFilters).forEach(([attribute, values]) => {
        gqlFilters[attribute] = { in: values.map(String) };
      });

      return gqlFilters;
    }
    
    function getActiveFiltersFromUrl() {
      const params = new URLSearchParams(window.location.search);
      const filters = {};

      for (const [key, value] of params.entries()) {
        // Skip sorting/pagination params and non-filterable attributes
        if ([
          "product_list_dir",
          "product_list_mode",
          "product_list_order",
          "p", // pagination
          "product_list_limit",
          "revenue_ranking", // Not a filterable attribute, used for sorting only
          "srsltid",
          "spotlight"
        ].includes(key)) {
          continue;
        }
		
		if (!allattributesdata.includes(key)) {
		  continue;
		}

        // Split comma-separated values (ex: "116475,116469")
        const values = value.split(',').map(v => v.trim()).filter(v => v);

        if (!filters[key]) {
          filters[key] = [];
        }
        filters[key].push(...values);
      }

      return filters;
    }
    
    function getActiveFilters() {
        const urlParams = new URLSearchParams(window.location.search);

        // Excluded params (not filters)
        const excludedParams = [
            'id',
            'p',
            'product_list_dir',
            'product_list_order',
            'product_list_limit',
            'product_list_mode'
        ];

        let filterParams = {};

        for (let [key, value] of urlParams.entries()) {
			if (excludedParams.includes(key)) {
			  continue;
			}
			if (!allattributesdata.includes(key)) {
			  continue;
			}
            filterParams[key] = value;
        }

        return filterParams;
    }
    function getAllproductsIds() {
        (async () => {
          const categoryElement = document.querySelector('.products.wrapper');
          const categoryId = categoryElement ? categoryElement.getAttribute('categoryid') : null;

          const products = await getAllFilteredProductIdsCustom(categoryId);
          // 🔄 Calculate total revenue
          const totalRevenue = products.reduce((sum, p) => sum + (parseFloat(p.revenue_ranking) || 0), 0);

          // 🔄 Convert to buyPercentages format
          const buyPercentages = products.map(p => {
            const revenue = parseFloat(p.revenue_ranking) || 0;
            return {
              product_id: p.id,
              revenue: revenue,
              buy_percentage: totalRevenue > 0 ? ((revenue / totalRevenue) * 100).toFixed(2) : 0,
              has_revenue_data: revenue > 0
            };
          });
		  
		  // Select all filter links inside the category-top-filter block
		const filterLinks = document.querySelectorAll('.category-top-filter a.special-filters');

		filterLinks.forEach(link => {
			const url = new URL(link.href, window.location.origin);
			url.searchParams.set('product_list_dir', 'desc');
			url.searchParams.set('product_list_order', 'revenue_ranking');
			link.href = url.toString();
		});
          
          displayBuyPercentages(buyPercentages);
        })();
    }
    
