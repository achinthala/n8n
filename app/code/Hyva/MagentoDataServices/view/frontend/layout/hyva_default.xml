<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">

    <head>
        <script src="Hyva_MagentoDataServices::js/storefront-event-collector.js" defer="defer"/>
        <script src="Hyva_MagentoDataServices::js/storefront-events-sdk.js" defer="defer"/>
    </head>
    <body>
        <referenceContainer name="head.additional">
            <block class="Magento\DataServices\Block\Context" name="dataservices_base" template="Magento_DataServices::ds.phtml">
                <arguments>
                    <argument name="page_type" xsi:type="string">Default</argument>
                    <argument name="step_name" xsi:type="string">page-view</argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceContainer name="before.body.end">
            <block name="set_cart_context_via_section_data" template="Hyva_MagentoDataServices::set-cart-context.phtml" before="-" />
        </referenceContainer>
    </body>
</page>
