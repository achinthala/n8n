<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="set_cart_context_via_section_data" remove="true" />
        <referenceContainer name="before.body.end">
            <block class="Magento\DataServices\Block\Context" name="dataservices_checkout_success"
                   template="Magento_DataServices::checkout-success.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">
                        Magento\DataServices\ViewModel\Checkout\SuccessContextProvider
                    </argument>
                    <argument name="step_name" xsi:type="string">place-order</argument>
                    <argument name="page_type" xsi:type="string">Checkout</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
