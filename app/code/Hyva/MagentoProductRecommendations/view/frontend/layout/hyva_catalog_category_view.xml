<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="before.body.end">
            <block name="product_recommendations_fetcher"
                   template="Hyva_MagentoProductRecommendations::recsFetcher.phtml" after="magento-recs-sdk"/>
        </referenceContainer>
        <referenceBlock name="content">
            <block class="Magento\ProductRecommendationsLayout\Block\Renderer" before="-"
                   name="product_recommendations_category_before_content"
                   template="Magento_ProductRecommendationsLayout::layoutRenderer.phtml">
                <arguments>
                    <argument name="pagePlacement" xsi:type="string">above-main-content</argument>
                </arguments>
            </block>
            <block class="Magento\ProductRecommendationsLayout\Block\Renderer" after="-"
                   name="product_recommendations_category_below_content"
                   template="Magento_ProductRecommendationsLayout::layoutRenderer.phtml">
                <arguments>
                    <argument name="pagePlacement" xsi:type="string">below-main-content</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
