+    private function cleanBreadcrumbItems(array $items): array
+    {
+        $invalidProperties = [
+            'aggregateRating',
+            'review',
+            'itemReviewed',
+            'reviewRating',
+            'author',
+            'dateCreated',
+            'datePublished',
+            'headline',
+            'reviewBody',
+            'ratingValue',
+            'reviewCount',
+            'bestRating'
+        ];
+
+        foreach ($items as &$item) {
+            // Clean the ListItem itself
+            foreach ($invalidProperties as $prop) {
+                if (isset($item[$prop])) {
+                    unset($item[$prop]);
+                }
+            }
+
+            // Clean the nested item (WebPage)
+            if (isset($item['item']) && is_array($item['item'])) {
+                foreach ($invalidProperties as $prop) {
+                    if (isset($item['item'][$prop])) {
+                        unset($item['item'][$prop]);
+                    }
+                }
+
+                // Ensure @type is set correctly
+                if (!isset($item['item']['@type']) || $item['item']['@type'] !== 'WebPage') {
+                    $item['item']['@type'] = 'WebPage';
