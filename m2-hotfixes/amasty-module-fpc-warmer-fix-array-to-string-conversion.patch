+    /**
+     * Convert value to string, handling arrays recursively
+     *
+     * @param mixed $value
+     * @return string
+     */
+    private function convertValueToString($value): string
+    {
+        if (is_array($value)) {
+            if (empty($value)) {
+                return '';
+            }
+            if (count($value) === 1) {
+                return $this->convertValueToString(reset($value));
+            }
+            foreach ($value as $item) {
+                if (!is_array($item)) {
+                    return (string)$item;
+                }
+            }
+            return json_encode($value);
+        }
+        return (string)$value;
+    }
